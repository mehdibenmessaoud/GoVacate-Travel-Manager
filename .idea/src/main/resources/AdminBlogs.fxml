<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.projet.GUI.AdminBlogController">
    <children>
        <!-- Titre -->
        <Label layoutX="30.0" layoutY="30.0" text="Gestion des Blogues" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Tableau -->
        <TableView fx:id="tableBlogs" layoutX="30.0" layoutY="80.0" prefHeight="480.0" prefWidth="840.0" stylesheets="@style.css">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="#" />
                <TableColumn fx:id="colTitre" prefWidth="200.0" text="Titre" />
                <TableColumn fx:id="colContenu" prefWidth="250.0" text="Contenu" />
                <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Statut" />
                <TableColumn fx:id="colAction" prefWidth="110.0" text="Action" />
            </columns>
        </TableView>

        <!-- Bouton Actualiser -->
        <Button layoutX="780.0" layoutY="35.0" mnemonicParsing="false" onAction="#refreshTable" text="Actualiser" />
    </children>
</AnchorPane>