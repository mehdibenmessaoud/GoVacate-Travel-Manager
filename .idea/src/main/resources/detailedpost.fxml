<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.projet.GUI.DetailedPostControllor">
    <content>
        <VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="30.0" style="-fx-background-color: transparent;">
            <padding><Insets bottom="40.0" left="50.0" right="50.0" top="40.0" /></padding>

            <HBox alignment="CENTER_LEFT">
                <Button onAction="#handleClose" styleClass="btn-secondary" text="← Retour"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 10;"/>
            </HBox>

            <VBox spacing="25.0" styleClass="glass-panel" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 20;">
                <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>

                <VBox alignment="CENTER" spacing="10">
                    <StackPane fx:id="carouselContainer" prefHeight="450.0" prefWidth="700.0"
                               style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 15;">
                        <ImageView fx:id="currentImageView" fitHeight="430.0" fitWidth="680.0" preserveRatio="true" />
                        <Button fx:id="btnPrev" onAction="#showPreviousImage" text="&lt;" StackPane.alignment="CENTER_LEFT"
                                style="-fx-background-color: rgba(0,0,0,0.6); -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 45; -fx-cursor: hand;">
                            <StackPane.margin><Insets left="15"/></StackPane.margin>
                        </Button>
                        <Button fx:id="btnNext" onAction="#showNextImage" text="&gt;" StackPane.alignment="CENTER_RIGHT"
                                style="-fx-background-color: rgba(0,0,0,0.6); -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 45; -fx-cursor: hand;">
                            <StackPane.margin><Insets right="15"/></StackPane.margin>
                        </Button>
                    </StackPane>
                    <Label fx:id="lblImageCount" style="-fx-text-fill: #b0b0b0;" text="1 / 1" />
                </VBox>

                <VBox spacing="10.0" alignment="TOP_LEFT">
                    <Label fx:id="lblTitre" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="Titre" wrapText="true" />
                    <Label fx:id="lblMeta" style="-fx-text-fill: #b0b0b0;" text="Meta Info" />
                    <Separator opacity="0.2" />
                    <Text fx:id="txtContent" fill="WHITE" style="-fx-font-size: 17px;" wrappingWidth="750.0" />
                </VBox>

                <Separator opacity="0.2" />

                <VBox spacing="15.0">
                    <HBox spacing="20.0" alignment="CENTER_LEFT">
                        <Button fx:id="btnLike" onAction="#handleLike" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20;">
                            <text>❤️ J'aime</text>
                        </Button>
                        <Label fx:id="lblLikeCount" text="0 likes" style="-fx-text-fill: #b0b0b0;" />
                    </HBox>

                    <Separator opacity="0.1" />

                    <HBox spacing="10.0" alignment="CENTER">
                        <TextField fx:id="commentInput" promptText="Écrivez un commentaire..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-prompt-text-fill: gray; -fx-background-radius: 10; -fx-padding: 10;"/>
                        <Button onAction="#handleAddComment" text="Envoyer"
                                style="-fx-background-color: #ff9f43; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10 20;"/>
                    </HBox>
                </VBox>

                <Separator opacity="0.2" />

                <VBox spacing="10.0">
                    <Label text="Commentaires" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ScrollPane fitToWidth="true" minHeight="150" maxHeight="300" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox fx:id="commentsListContainer" spacing="10.0">
                        </VBox>
                    </ScrollPane>
                </VBox>

                <HBox alignment="CENTER_RIGHT">
                    <Button onAction="#handleClose" styleClass="btn-orange-glow" text="Fermer" prefHeight="45.0" prefWidth="150.0"
                            style="-fx-background-color: #ff9f43; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>