<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" styleClass="content-pane" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.RestaurantMenuFormController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button onAction="#handleCancel" styleClass="btn-action-view" text="← Annuler" />
        <Label fx:id="lblTitle" styleClass="text-header" text="Détails du Plat" />
    </HBox>

    <VBox spacing="20" styleClass="glass-panel" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>

        <GridPane hgap="20" vgap="15">
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="120" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label styleClass="form-label" text="Nom du Plat" GridPane.rowIndex="0" />
            <TextField fx:id="txtName" styleClass="search-field-large" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label styleClass="form-label" text="Description" GridPane.rowIndex="1" />
            <TextArea fx:id="txtDescription" prefHeight="80" styleClass="search-field-large" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label styleClass="form-label" text="Prix (TND)" GridPane.rowIndex="2" />
            <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <TextField fx:id="txtPrice" prefWidth="150" styleClass="search-field-large" />
                <Label styleClass="form-label" text="Statut :" />
                <ComboBox fx:id="cbStatus" prefWidth="150" styleClass="combo-box-glass" />
            </HBox>
        </GridPane>

        <Separator opacity="0.2" />

        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <Label styleClass="form-label" text="Photo du Plat (Sélection Unique)" />
            <Button onAction="#handleUploadImage" styleClass="btn-orange-glow" text="+ Sélectionner une Photo" />

            <ScrollPane fitToWidth="true" minHeight="180" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: #ddd; -fx-border-style: dashed; -fx-border-radius: 10;">
                <VBox fx:id="imagePreviewContainer" alignment="CENTER" spacing="10">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>
                    <Label text="Aucune image sélectionnée" textFill="#95a5a6" />
                </VBox>
            </ScrollPane>
        </VBox>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15">
        <Button onAction="#handleSave" prefHeight="45" prefWidth="200" styleClass="btn-orange-glow" text="VALIDER LE PLAT" />
    </HBox>
</VBox>