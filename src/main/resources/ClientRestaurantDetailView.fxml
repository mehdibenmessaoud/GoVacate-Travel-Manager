<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@/css/admin_light.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.ClientRestaurantDetailController">

    <ScrollPane fx:id="rootScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #0b0f14;">
        <content>
            <VBox spacing="30.0" style="-fx-background-color: #0b0f14;">
                <padding><Insets bottom="30" left="25" right="25" top="20" /></padding>

                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Button onAction="#handleBack" style="-fx-background-color: #333; -fx-text-fill: white; -fx-cursor: hand;" text="← Retour" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🌐 Language:" style="-fx-text-fill: white;" />
                            <ComboBox fx:id="comboLanguage" style="-fx-background-color: #333; -fx-text-fill: white;" />
                        </HBox>
                        <Label fx:id="lblName" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" text="Nom du Restaurant" />
                        <Label fx:id="lblAddress" style="-fx-text-fill: #999; -fx-font-size: 14;" text="📍 Localisation" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="10">
                        <Button onAction="#handleReservation" prefHeight="50" prefWidth="180" style="-fx-background-color: #FF8210; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-cursor: hand; -fx-background-radius: 8;" text="RÉSERVER" />
                        <Button onAction="#handleSetDestination" prefHeight="35" prefWidth="180" style="-fx-background-color: transparent; -fx-border-color: #FF8210; -fx-border-radius: 8; -fx-text-fill: #FF8210; -fx-cursor: hand;" text="📍 Itinéraire Mobile" />
                        <Label fx:id="lblPhone" style="-fx-text-fill: #777;" text="Téléphone" />
                    </VBox>
                </HBox>

                <VBox alignment="CENTER" spacing="15">
                    <StackPane fx:id="carouselContainer" maxHeight="450.0" minHeight="450.0" prefHeight="450.0" style="-fx-background-color: #000; -fx-background-radius: 15; -fx-border-color: #333; -fx-border-radius: 15; -fx-overflow: hidden;">
                        <ImageView fx:id="mainCarouselImageView" fitHeight="450.0" pickOnBounds="true" preserveRatio="true" />
                        <HBox alignment="CENTER" pickOnBounds="false">
                            <Button onAction="#handlePrevImage" style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white; -fx-font-size: 30; -fx-cursor: hand;" text="‹" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleNextImage" style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white; -fx-font-size: 30; -fx-cursor: hand;" text="›" />
                        </HBox>
                        <VBox alignment="BOTTOM_CENTER" pickOnBounds="false" spacing="10">
                            <HBox fx:id="paginationContainer" alignment="CENTER" spacing="8" />
                            <HBox alignment="CENTER" maxWidth="200" spacing="15" style="-fx-background-color: rgba(0,0,0,0.7); -fx-background-radius: 20; -fx-padding: 5;">
                                <Button fx:id="btnToggleAutoPlay" onAction="#toggleAutoPlay" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="⏸" />
                                <Label fx:id="lblImageCounter" style="-fx-text-fill: white;" text="1 / 1" />
                                <Button onAction="#handleFullScreen" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="⛶" />
                            </HBox>
                            <StackPane.margin><Insets bottom="15" /></StackPane.margin>
                        </VBox>
                    </StackPane>
                    <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" maxHeight="90" minHeight="90" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER">
                        <HBox fx:id="thumbnailContainer" alignment="CENTER_LEFT" spacing="10" />
                    </ScrollPane>
                </VBox>

                <Separator opacity="0.1" />

                <HBox spacing="40">
                    <VBox spacing="20" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 24; -fx-text-fill: white; -fx-font-weight: bold;" text="🍴 Le Menu" />
                        <TextField fx:id="txtSearchMenu" maxWidth="400" promptText="🔍 Rechercher un plat..." style="-fx-background-color: #1a1e23; -fx-text-fill: white; -fx-border-color: #333; -fx-border-radius: 8; -fx-padding: 10;" />
                        <FlowPane fx:id="menuFlowPane" hgap="20" prefWrapLength="700" vgap="20" />
                    </VBox>

                    <VBox minWidth="350" prefWidth="400" spacing="20" style="-fx-background-color: #0d1117; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #21262d; -fx-border-radius: 15;">
                        <Label style="-fx-font-size: 24; -fx-text-fill: white; -fx-font-weight: bold;" text="⭐ Avis" />
                        <VBox fx:id="reviewInputSection" spacing="15">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <HBox fx:id="starRatingContainer" />
                                <Label fx:id="lblRatingValue" style="-fx-text-fill: #FF8210; -fx-font-weight: bold;" text="5 / 5" />
                            </HBox>
                            <TextArea fx:id="txtComment" prefHeight="100" promptText="Laissez votre avis ici..." style="-fx-control-inner-background: #161b22; -fx-text-fill: white; -fx-border-color: #30363d;" wrapText="true" />
                            <Button fx:id="btnSubmitReview" onAction="#handleSubmitReview" prefWidth="400" style="-fx-background-color: #FF8210; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Publier mon avis" />
                        </VBox>
                        <Separator opacity="0.1" />
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="500" style="-fx-background-color: transparent; -fx-background: transparent;">
                            <VBox fx:id="reviewsContainer" spacing="15" />
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>

    <StackPane fx:id="navigationOverlay" visible="false" style="-fx-background-color: rgba(0,0,0,0.85);">
        <VBox spacing="20" maxWidth="380" maxHeight="520" alignment="CENTER" style="-fx-background-color: #1a1a1a; -fx-background-radius: 25; -fx-border-color: #FF8210; -fx-border-width: 2; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, 10);">

            <Label text="📍 Itinéraire Mobile" style="-fx-text-fill: #FF8210; -fx-font-size: 20; -fx-font-weight: bold;"/>

            <HBox spacing="30" alignment="CENTER">
                <VBox alignment="CENTER">
                    <Label fx:id="distLabel" text="0.0 km" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
                    <Label text="DISTANCE" style="-fx-text-fill: gray; -fx-font-size: 10;"/>
                </VBox>
                <VBox alignment="CENTER">
                    <Label fx:id="timeLabel" text="0 min" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
                    <Label text="À PIED" style="-fx-text-fill: gray; -fx-font-size: 10;"/>
                </VBox>
            </HBox>

            <ImageView fx:id="qrCodeView" fitWidth="220" fitHeight="220" style="-fx-effect: dropshadow(gaussian, white, 5, 0, 0, 0);"/>

            <Label fx:id="fullAddressLabel" text="Chargement de l'adresse..." wrapText="true" textAlignment="CENTER" style="-fx-text-fill: #ddd; -fx-font-size: 12;"/>

            <Label text="Scannez pour ouvrir Google Maps" style="-fx-text-fill: #888; -fx-font-size: 11;"/>

            <Button text="Fermer" onAction="#handleCloseNavigation" prefWidth="150" style="-fx-background-color: transparent; -fx-border-color: #444; -fx-text-fill: white; -fx-border-radius: 8; -fx-cursor: hand;" />
        </VBox>
    </StackPane>
</StackPane>