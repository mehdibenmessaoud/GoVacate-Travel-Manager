<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" styleClass="main-content" stylesheets="@css/admin.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.DestinationFormController">
    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
    </padding>

    <VBox maxWidth="600.0" spacing="15.0" styleClass="glass-card" style="-fx-padding: 30;">
        <children>
            <Text fx:id="formTitle" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 24; -fx-font-weight: bold;" text="Détails de la Destination" />

            <Separator opacity="0.2" prefWidth="200.0" />

            <GridPane hgap="15.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                </rowConstraints>

                <children>
                    <Label text="Nom de Destination :" textFill="WHITE" />
                    <TextField fx:id="nameField" promptText="Ex: Bali, Indonésie" styleClass="modern-textfield" GridPane.columnIndex="1" />

                    <Label text="Pays :" textFill="WHITE" GridPane.rowIndex="1" />
                    <TextField fx:id="paysField" promptText="Ex: France" styleClass="modern-textfield" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Ville :" textFill="WHITE" GridPane.rowIndex="2" />
                    <TextField fx:id="villeField" promptText="Ex: Paris" styleClass="modern-textfield" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Nom de l'image :" textFill="WHITE" GridPane.rowIndex="3" />
                    <TextField fx:id="imageField" promptText="image.jpg" styleClass="modern-textfield" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </children>
            </GridPane>

            <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                <children>
                    <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5;" text="Annuler" />
                    <Button fx:id="btnEnregistrer" onAction="#handleSave" prefHeight="40.0" prefWidth="150.0" styleClass="btn-orange-glow" text="Enregistrer" />
                </children>
            </HBox>
        </children>
    </VBox>
</VBox>