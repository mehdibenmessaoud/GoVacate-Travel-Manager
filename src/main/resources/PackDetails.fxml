<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="20" styleClass="details-container-glass" stylesheets="@css/client_style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.projet.gui.PackDetailsController">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button fx:id="btnBack" text="← Retour" onAction="#handleBack" styleClass="btn-back-simple"/>
        <VBox>
            <Label fx:id="nameLabel" styleClass="details-header-title"/>
            <Label fx:id="categoryLabel" styleClass="text-sub-blue"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />

        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 10;">
            <HBox alignment="CENTER" spacing="10">
                <ImageView fx:id="weatherIcon" fitHeight="40" fitWidth="40" preserveRatio="true" />
                <Label fx:id="tempLabel" style="-fx-font-size: 18; -fx-text-fill: #FF8210; -fx-font-weight: bold;" text="--°C" />
            </HBox>
            <Label fx:id="descLabel" style="-fx-text-fill: white; -fx-font-size: 11;" text="Chargement..." />
        </VBox>

        <Label fx:id="statusLabel" styleClass="status-badge-details" />
    </HBox>

    <Separator styleClass="details-separator"/>

    <HBox spacing="30">
        <VBox spacing="20" alignment="TOP_CENTER">
            <StackPane alignment="TOP_RIGHT">
                <ImageView fx:id="packImageView" fitWidth="420" fitHeight="260"
                           preserveRatio="false" styleClass="image-view-details" />
                <Label fx:id="promoBadge" visible="false" text="OFFRE FLASH"
                       style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 15;
                  -fx-font-weight: bold; -fx-background-radius: 0 0 0 15; -fx-font-size: 13px;"/>
            </StackPane>

            <VBox alignment="CENTER" spacing="10" styleClass="price-container-details">
                <Label text="PRIX DU PACK" styleClass="search-label" style="-fx-text-fill: #adb5bd;"/>
                <HBox alignment="CENTER" spacing="15">
                    <Label fx:id="priceLabel" styleClass="details-price-large"/>
                    <Separator orientation="VERTICAL" prefHeight="30" opacity="0.2"/>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <ComboBox fx:id="currencyCombo" prefWidth="90.0" styleClass="combo-box-custom"/>
                        <Label fx:id="convertedPriceLabel" style="-fx-text-fill: #ff9800; -fx-font-weight: bold; -fx-font-size: 14px;" />
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <VBox>
                <Label text="DESTINATION" styleClass="search-label"/>
                <Label fx:id="destinationLabel" styleClass="details-meta-text"/>
            </VBox>

            <HBox spacing="40">
                <VBox>
                    <Label text="HÔTEL" styleClass="search-label"/>
                    <Label fx:id="hotelLabel" styleClass="details-meta-text"/>
                </VBox>
                <VBox>
                    <Label text="EXCURSION" styleClass="search-label"/>
                    <Label fx:id="excursionLabel" styleClass="details-meta-text"/>
                </VBox>
                <VBox>
                    <Label text="DURÉE" styleClass="search-label"/>
                    <Label fx:id="durationLabel" styleClass="details-meta-text"/>
                </VBox>
            </HBox>

            <HBox spacing="40">
                <VBox>
                    <Label text="DATE DÉBUT" styleClass="search-label"/>
                    <Label fx:id="dateDebutLabel" styleClass="details-meta-text"/>
                </VBox>
                <VBox>
                    <Label text="DATE FIN" styleClass="search-label"/>
                    <Label fx:id="dateFinLabel" styleClass="details-meta-text"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="DESCRIPTION" styleClass="search-label"/>
                <Label fx:id="descriptionLabel" wrapText="true" maxWidth="500" styleClass="details-description-label"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnReserver" onAction="#handleGoToBooking" text="Confirmer la Réservation" styleClass="btn-orange-glow" maxWidth="Infinity" prefHeight="55"/>
        </VBox>
    </HBox>
</VBox>