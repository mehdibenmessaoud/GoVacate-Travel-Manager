<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<AnchorPane prefHeight="650.0" prefWidth="450.0" styleClass="main-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.RestaurantBookingController">

    <stylesheets>
        <URL value="@/css/booking_style.css" />
    </stylesheets>

    <children>
        <VBox alignment="CENTER" prefHeight="130.0" prefWidth="450.0" spacing="5" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label style="-fx-letter-spacing: 3;" text="GASTRONOMIE LUXE" textFill="#00FFCC">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>
                <Label text="Réserver une Table" textFill="WHITE">
                    <font><Font name="Segoe UI Bold" size="28.0" /></font>
                </Label>
                <Separator maxWidth="50" style="-fx-opacity: 0.3; -fx-background-color: #FFBD59;" />
            </children>
        </VBox>

        <VBox layoutX="35.0" layoutY="140.0" prefWidth="380.0" spacing="25.0" styleClass="glass-card">
            <padding>
                <Insets bottom="30.0" left="25.0" right="25.0" top="30.0" />
            </padding>
            <children>
                <VBox spacing="8">
                    <Label style="-fx-font-weight: bold;" text="🍽️ Restaurant" textFill="#679AC1" />
                    <ComboBox fx:id="comboResto" prefHeight="45.0" prefWidth="330.0" promptText="Choisir un lieu..." />
                </VBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: bold;" text="📅 Date" textFill="#679AC1" />
                            <DatePicker fx:id="dateRes" prefHeight="45.0" prefWidth="150.0" />
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: bold;" text="⏰ Heure" textFill="#679AC1" />
                            <ComboBox fx:id="comboHeure" prefHeight="45.0" prefWidth="150.0" promptText="--:--" />
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="8">
                    <Label style="-fx-font-weight: bold;" text="👥 Invités" textFill="#679AC1" />
                    <TextField fx:id="txtPersonnes" prefHeight="45.0" promptText="Nombre de personnes" />
                </VBox>
            </children>
        </VBox>

        <VBox alignment="CENTER" layoutY="510.0" prefWidth="450.0" spacing="10.0" AnchorPane.bottomAnchor="15.0">
            <children>
                <Button fx:id="btnValider" mnemonicParsing="false" onAction="#handleReserverRestaurant" prefHeight="55.0" prefWidth="320.0" styleClass="btn-confirm" text="CONFIRMER LA RÉSERVATION">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Button>

                <Button fx:id="btnAnnuler" managed="false" visible="false" mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="320.0" style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 10; -fx-text-fill: white; -fx-cursor: hand;" text="ANNULER LES MODIFICATIONS">
                    <font><Font size="13.0" /></font>
                </Button>

                <Label text="Confirmation immédiate • Sans frais de service" textFill="rgba(255,255,255,0.4)">
                    <font><Font size="10.0" /></font>
                </Label>
            </children>
        </VBox>
    </children>
</AnchorPane>