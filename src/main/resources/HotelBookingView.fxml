<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="20" prefWidth="450.0" styleClass="root-pane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.projet.gui.HotelBookingController">
    <stylesheets>
        <URL value="@/css/mes_reservations.css" />
    </stylesheets>
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <VBox spacing="5" alignment="CENTER">
        <Label text="RÉSERVATION HÔTEL" style="-fx-text-fill: #679AC1; -fx-font-weight: bold; -fx-letter-spacing: 2;"/>
        <Label fx:id="lblHotelName" text="Nom de l'Hôtel" styleClass="logo-text" style="-fx-font-size: 24;"/>
    </VBox>

    <VBox spacing="15" styleClass="glass-card">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <VBox spacing="8">
            <Label text="DATE CHECK-IN" styleClass="admin-mini-label" style="-fx-text-fill: #FFBD59;"/>
            <DatePicker fx:id="dpCheckIn" prefWidth="400" styleClass="combo-box"/>
        </VBox>

        <VBox spacing="8">
            <Label text="DATE CHECK-OUT" styleClass="admin-mini-label" style="-fx-text-fill: #FFBD59;"/>
            <DatePicker fx:id="dpCheckOut" prefWidth="400" styleClass="combo-box"/>
        </VBox>
    </VBox>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Annuler" onAction="#handleCancel" styleClass="btn-secondary" prefWidth="120" prefHeight="40"/>
        <Button text="RÉSERVER MAINTENANT" onAction="#handleConfirm" styleClass="btn-orange-glow" prefWidth="250" prefHeight="40"/>
    </HBox>
</VBox>