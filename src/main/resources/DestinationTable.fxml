<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="25.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.AdminDestinationController">
    <padding>
        <Insets top="40.0" right="50.0" bottom="50.0" left="50.0"/>
    </padding>

    <VBox spacing="25.0">
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <VBox spacing="3.0">
                <Label styleClass="text-header" text="Gestion des Destinations"/>
                <Label styleClass="text-sub" text="GÃ©rez les lieux de voyage disponibles"/>
            </VBox>
        </HBox>

        <VBox alignment="CENTER" spacing="25.0" styleClass="glass-panel">
            <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="15.0" prefHeight="70.0" styleClass="search-bar-liquid">
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label styleClass="search-label" text="Rechercher une destination"/>
                    <TextField fx:id="searchField"  promptText="Nom, pays ou ville..." styleClass="search-field"/>
                </VBox>
                <Button  prefHeight="50.0" prefWidth="140.0" styleClass="btn-orange-glow" text="Rechercher"/>

                <Button onAction="#onAddDestination" prefHeight="50.0" prefWidth="200.0" styleClass="btn-orange-glow" text="+ Ajouter Destination"/>
            </HBox>
        </VBox>

        <VBox styleClass="glass-card" style="-fx-padding: 10;" VBox.vgrow="ALWAYS">
            <TableView fx:id="destTable" prefHeight="450.0" minHeight="300.0" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                    <TableColumn fx:id="colPays" prefWidth="120.0" text="Pays" />
                    <TableColumn fx:id="colVille" prefWidth="120.0" text="Ville" />
                    <TableColumn fx:id="colActions" prefWidth="250.0" text="Actions" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
