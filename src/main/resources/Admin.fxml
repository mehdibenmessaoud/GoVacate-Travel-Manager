<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefHeight="750.0" prefWidth="1300.0" styleClass="root-pane" stylesheets="@css/admin-style.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.projet.gui.AdminController">

    <!-- 1. FOND "EAU PROFONDE" -->
    <Pane styleClass="deep-water-bg">
        <!-- Bulles floues d'ambiance -->
        <Circle fill="#FF8210" layoutX="150.0" layoutY="150.0" opacity="0.15" radius="180.0">
            <effect>
                <GaussianBlur radius="80.0"/>
            </effect>
        </Circle>
        <Circle fill="#679AC1" layoutX="1150.0" layoutY="600.0" opacity="0.1" radius="250.0">
            <effect>
                <GaussianBlur radius="100.0"/>
            </effect>
        </Circle>
    </Pane>

    <BorderPane>

        <!-- 2. SIDEBAR GAUCHE -->
        <left>
            <AnchorPane prefWidth="260.0" styleClass="sidebar-liquid">

                <!-- LOGO -->
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="20.0">
                    <Circle fill="#FF8210" radius="8.0" stroke="WHITE" strokeWidth="2.0"/>
                    <Label styleClass="logo-text" text="GoVacate"/>
                </HBox>

                <!-- BULLE MAGIQUE (Sliding Pane) -->
                <Pane fx:id="slidingPane" layoutX="20.0" layoutY="140.0"
                      mouseTransparent="true" pickOnBounds="false"
                      prefHeight="45.0" prefWidth="220.0" styleClass="sliding-highlight"/>

                <!-- CONTAINER BOUTONS -->
                <VBox fx:id="menuContainer" layoutY="140.0" spacing="0.0"
                      AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <children>
                        <Button fx:id="btnHotels" onAction="#showHotelsView" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Hotels"/>
                        <Button fx:id="btnChambres" onAction="#showRoomsView" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Chambres"/>
                        <Pane prefHeight="50.0" mouseTransparent="true"/>
                        <Button fx:id="btnRefresh" onAction="#refreshData" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Actualiser"/>
                        <Button fx:id="btnLogout" onAction="#handleLogout" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Deconnexion"/>
                    </children>
                </VBox>
            </AnchorPane>
        </left>

        <!-- 3. CONTENU CENTRAL -->
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane">
                <VBox fx:id="mainContent" spacing="25.0">
                    <padding><Insets top="40.0" right="50.0" bottom="50.0" left="50.0"/></padding>

                    <!-- ==================== LIST VIEW ==================== -->
                    <VBox fx:id="listViewSection" spacing="25.0">
                        
                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <VBox spacing="3.0">
                                <Label fx:id="pageTitle" styleClass="text-header" text="Gestion des Hotels"/>
                                <Label fx:id="pageSubtitle" styleClass="text-sub" text="Gerez vos hotels et leurs informations"/>
                            </VBox>
                        </HBox>

                        <!-- BARRE DE RECHERCHE (GLASS PANEL) -->
                        <VBox alignment="CENTER" spacing="25.0" styleClass="glass-panel">
                            <padding>
                                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                            </padding>
                            <Label styleClass="hero-title" text="Recherche et Actions"/>
                            <HBox alignment="CENTER_LEFT" spacing="15.0" prefHeight="70.0" styleClass="search-bar-liquid">
                                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                    <Label styleClass="search-label" text="Rechercher"/>
                                    <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-field" onKeyReleased="#handleSearch"/>
                                </VBox>
                                <Pane prefWidth="1.0" style="-fx-background-color: #6C6D6F; -fx-opacity: 0.3;"/>
                                <VBox fx:id="filterContainer" alignment="CENTER_LEFT" HBox.hgrow="SOMETIMES">
                                    <Label fx:id="filterLabel" styleClass="search-label" text="Filtrer"/>
                                    <ComboBox fx:id="starsFilterCombo" promptText="Etoiles" styleClass="search-field" prefWidth="150.0" onAction="#handleFilter"/>
                                    <ComboBox fx:id="hotelFilterCombo" promptText="Filtrer par hotel" styleClass="search-field" prefWidth="180.0" onAction="#handleFilter" visible="false" managed="false"/>
                                </VBox>
                                <Pane fx:id="roomFilterSeparator" prefWidth="1.0" style="-fx-background-color: #6C6D6F; -fx-opacity: 0.3;" visible="false" managed="false"/>
                                <VBox fx:id="roomTypeFilterContainer" alignment="CENTER_LEFT" HBox.hgrow="SOMETIMES" visible="false" managed="false">
                                    <Label fx:id="roomTypeFilterLabel" styleClass="search-label" text="Type"/>
                                    <ComboBox fx:id="roomTypeFilterCombo" promptText="Type de chambre" styleClass="search-field" prefWidth="140.0" onAction="#handleFilter"/>
                                </VBox>
                                <VBox fx:id="roomStatusFilterContainer" alignment="CENTER_LEFT" HBox.hgrow="SOMETIMES" visible="false" managed="false">
                                    <Label fx:id="roomStatusFilterLabel" styleClass="search-label" text="Statut"/>
                                    <ComboBox fx:id="roomStatusFilterCombo" promptText="Statut" styleClass="search-field" prefWidth="130.0" onAction="#handleFilter"/>
                                </VBox>
                                <Button fx:id="searchButton" onAction="#handleSearch" prefHeight="50.0" prefWidth="160.0" styleClass="btn-orange-glow" text="Rechercher"/>
                                <Button fx:id="addButton" onAction="#handleAdd" prefHeight="50.0" prefWidth="180.0" styleClass="btn-orange-glow" text="+ Ajouter"/>
                            </HBox>
                        </VBox>

                        <!-- Section Titre -->
                        <Label styleClass="section-title" text="Liste d'hotels"/>
                        
                        <!-- Table -->
                        <VBox styleClass="glass-card" style="-fx-padding: 10;" VBox.vgrow="ALWAYS">
                            <TableView fx:id="mainTable" styleClass="admin-table" prefHeight="420.0" minHeight="300.0" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="col1" text="Nom" minWidth="120.0" prefWidth="160.0"/>
                                    <TableColumn fx:id="col2" text="Description" minWidth="170.0" prefWidth="250.0"/>
                                    <TableColumn fx:id="col3" text="Info" minWidth="100.0" prefWidth="130.0"/>
                                    <TableColumn fx:id="col4" text="Statut" minWidth="110.0" prefWidth="130.0"/>
                                    <TableColumn fx:id="col5" text="Details" minWidth="130.0" prefWidth="170.0"/>
                                    <TableColumn fx:id="col6" text="Actions" minWidth="300.0" prefWidth="360.0"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>

                    <!-- ==================== DETAIL VIEW (Full Page) ==================== -->
                    <VBox fx:id="detailViewSection" spacing="25.0" visible="false" managed="false">
                        
                        <!-- Back Button -->
                        <Button fx:id="backButton" onAction="#handleBackToList" styleClass="btn-back" text="Retour a la liste"/>

                        <!-- Detail Header with Image Gallery -->
                        <HBox spacing="30.0" alignment="TOP_LEFT">
                            
                            <!-- Left: Image Gallery -->
                            <VBox spacing="15.0" prefWidth="520.0">
                                <StackPane fx:id="mainImageContainer" prefHeight="330.0" styleClass="detail-media-frame">
                                    <ImageView fx:id="mainImageView" fitWidth="520.0" fitHeight="330.0" preserveRatio="true"/>
                                </StackPane>
                                <HBox fx:id="thumbnailsContainer" spacing="10.0" alignment="CENTER_LEFT"/>
                            </VBox>

                            <!-- Right: Info Section -->
                            <VBox spacing="18.0" HBox.hgrow="ALWAYS" styleClass="glass-card">
                                <Label fx:id="detailName" styleClass="text-header"/>
                                <Label fx:id="detailSubInfo" styleClass="text-sub"/>
                                <FlowPane fx:id="detailBadges" hgap="12.0" vgap="10.0"/>
                                <Label fx:id="detailDesc" style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.75); -fx-line-spacing: 3;" wrapText="true"/>
                                
                                <!-- Action Buttons -->
                                <FlowPane fx:id="detailActionButtons" hgap="12.0" vgap="12.0" alignment="CENTER_LEFT" prefWrapLength="620.0">
                                    <padding><Insets top="15.0"/></padding>
                                </FlowPane>
                            </VBox>
                        </HBox>

                        <!-- Services Section -->
                        <VBox fx:id="detailServicesSection" spacing="10.0" styleClass="glass-card">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label fx:id="detailServicesTitle" text="Services de l'hotel" styleClass="hero-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="detailManageServicesBtn" text="Gerer services"/>
                            </HBox>
                            <FlowPane fx:id="detailServicesPane" hgap="10.0" vgap="10.0" prefWrapLength="1080.0"/>
                        </VBox>

                        <!-- Reviews Section -->
                        <VBox fx:id="reviewsSection" spacing="15.0" styleClass="glass-card">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Avis clients" styleClass="hero-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="addReviewBtn" onAction="#showAddReviewDialog" styleClass="btn-orange-glow" text="+ Nouvel avis"/>
                            </HBox>
                            <TableView fx:id="reviewsTable" styleClass="admin-table" prefHeight="200.0" minHeight="150.0">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colReviewRating" text="Note" minWidth="120.0" prefWidth="150.0"/>
                                    <TableColumn fx:id="colReviewComment" text="Commentaire" minWidth="250.0" prefWidth="350.0"/>
                                    <TableColumn fx:id="colReviewUser" text="Utilisateur" minWidth="140.0" prefWidth="180.0"/>
                                    <TableColumn fx:id="colReviewActions" text="Actions" minWidth="180.0" prefWidth="220.0"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- Images Management Section (Hotels) -->
                        <VBox fx:id="imagesSection" spacing="15.0" styleClass="glass-card">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Gestion des images" styleClass="hero-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="addImageBtn" onAction="#showAddImageDialog" styleClass="btn-orange-glow" text="+ Ajouter image"/>
                            </HBox>
                            <TableView fx:id="imagesTable" styleClass="admin-table" prefHeight="180.0" minHeight="120.0">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colImagePath" text="Chemin de l'image" minWidth="300.0" prefWidth="450.0"/>
                                    <TableColumn fx:id="colImagePreview" text="Apercu" minWidth="100.0" prefWidth="150.0"/>
                                    <TableColumn fx:id="colImageActions" text="Actions" minWidth="120.0" prefWidth="150.0"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- Room Images Management Section -->
                        <VBox fx:id="roomImagesSection" spacing="15.0" styleClass="glass-card" visible="false" managed="false">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Gestion des images" styleClass="hero-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="addRoomImageBtn" onAction="#showAddImageDialog" styleClass="btn-orange-glow" text="+ Ajouter image"/>
                            </HBox>
                            <TableView fx:id="roomImagesTable" styleClass="admin-table" prefHeight="180.0" minHeight="120.0">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colRoomImagePath" text="Chemin de l'image" minWidth="300.0" prefWidth="450.0"/>
                                    <TableColumn fx:id="colRoomImagePreview" text="Apercu" minWidth="100.0" prefWidth="150.0"/>
                                    <TableColumn fx:id="colRoomImageActions" text="Actions" minWidth="120.0" prefWidth="150.0"/>
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>

                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>
</StackPane>
