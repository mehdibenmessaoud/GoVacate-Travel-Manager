<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" stylesheets="@css/admin.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.projet.gui.PackFormController">
    <VBox spacing="25.0" style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
        </padding>

        <VBox spacing="5.0">
            <Label styleClass="text-header" text="Gestion du Pack" />
            <Label styleClass="text-sub" text="Remplissez les détails du voyage, choisissez la destination et les services associés." />
        </VBox>

        <VBox spacing="25.0" styleClass="glass-card">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

            <GridPane hgap="30.0" vgap="25.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                </columnConstraints>

                <children>
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label styleClass="search-label" text="Nom du Pack" />
                        <TextField fx:id="nameField" promptText="Ex: Safari Tanzanie" styleClass="form-input" />
                    </VBox>
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label styleClass="search-label" text="Catégorie" />
                        <ComboBox fx:id="categoryCombo" maxWidth="1.7976931348623157E308" promptText="Sélectionner..." styleClass="form-input" />
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label styleClass="search-label" text="Destination (Ville)" />
                        <ComboBox fx:id="destinationCombo" maxWidth="1.7976931348623157E308" promptText="Choisir la destination..." styleClass="form-input" />
                    </VBox>
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label styleClass="search-label" text="Hôtel" />
                        <ComboBox fx:id="hotelCombo" maxWidth="1.7976931348623157E308" promptText="Choisir d'abord une destination" styleClass="form-input" />
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label styleClass="search-label" text="Excursion (Optionnel)" />
                        <ComboBox fx:id="excursionCombo" maxWidth="1.7976931348623157E308" promptText="Excursions disponibles..." styleClass="form-input" />
                    </VBox>
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label styleClass="search-label" text="Prix du Pack (DT)" />
                        <TextField fx:id="priceField" promptText="Ex: 1200.0" styleClass="form-input" />
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label styleClass="search-label" text="Date de Départ" />
                        <DatePicker fx:id="dateDepPicker" maxWidth="1.7976931348623157E308" styleClass="form-input" />
                    </VBox>
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <Label styleClass="search-label" text="Date d'Arrivée" />
                        <DatePicker fx:id="dateArrPicker" maxWidth="1.7976931348623157E308" styleClass="form-input" />
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="4">
                        <Label styleClass="search-label" text="Durée (Nombre de jours)" />
                        <TextField fx:id="durationField" promptText="Ex: 7" styleClass="form-input" />
                    </VBox>
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <Label styleClass="search-label" text="Statut" />
                        <ComboBox fx:id="statusCombo" maxWidth="1.7976931348623157E308" promptText="Disponibilité..." styleClass="form-input" />
                    </VBox>
                </children>
            </GridPane>

            <VBox spacing="8">
                <Label styleClass="search-label" text="Description détaillée" />
                <TextArea fx:id="descriptionArea" prefHeight="100.0" promptText="Décrivez le contenu du pack..." styleClass="form-input-area" wrapText="true" />
            </VBox>

            <VBox spacing="8">
                <Label styleClass="search-label" text="Nom de l'image (ex: voyage.jpg)" />
                <TextField fx:id="imageField" promptText="image_pack.jpg" styleClass="form-input" />
            </VBox>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="20.0">
            <Button onAction="#handleCancel" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white;" styleClass="btn-orange-glow" text="Annuler" />
            <Button onAction="#handleSave" prefHeight="50.0" prefWidth="220.0" styleClass="btn-orange-glow" text="Enregistrer le Pack" />
        </HBox>
    </VBox>
</ScrollPane>