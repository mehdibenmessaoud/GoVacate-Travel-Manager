<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.MesFacturesController">
    <stylesheets>
        <URL value="@/css/mes_reservations.css" />
    </stylesheets>
    <children>
        <VBox prefHeight="100.0" styleClass="sidebar-liquid" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="20.0">
                <padding><Insets left="40.0" right="40.0" /></padding>
                <Button onAction="#handleBack" prefHeight="40.0" prefWidth="40.0" styleClass="back-btn" text="←" />
                <VBox alignment="CENTER_LEFT">
                    <Label text="COMPTABILITÉ" styleClass="text-sub" style="-fx-font-size: 10; -fx-font-weight: 900; -fx-text-fill: #FFBD59;"/>
                    <Label text="Mes Factures &amp; Reçus" styleClass="logo-text" style="-fx-font-size: 24; -fx-text-fill: white;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Historique des paiements" style="-fx-text-fill: #679AC1; -fx-font-style: italic;" />
            </HBox>
        </VBox>

        <VBox spacing="20.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="120.0">



            <StackPane VBox.vgrow="ALWAYS" styleClass="glass-card">
                <TableView fx:id="tableFactures" styleClass="admin-table">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="100.0" text="N° FACTURE" />
                        <TableColumn fx:id="colResId" prefWidth="120.0" text="RÉSERVATION" />
                        <TableColumn fx:id="colDate" prefWidth="200.0" text="DATE DE PAIEMENT" />
                        <TableColumn fx:id="colMontant" prefWidth="150.0" text="MONTANT (DT)" />
                        <TableColumn fx:id="colMethode" prefWidth="150.0" text="MÉTHODE" />
                        <TableColumn fx:id="colAction" prefWidth="180.0" text="ACTIONS" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="Besoin d'aide pour vos factures ?" style="-fx-text-fill: #94A3B8;" />
                <Hyperlink text="Contacter le support" style="-fx-text-fill: #FF8210;" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>