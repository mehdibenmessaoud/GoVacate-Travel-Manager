<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefHeight="750.0" prefWidth="1100.0" styleClass="root-pane" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.ClientDashboardController">

    <Pane styleClass="deep-water-bg">
        <Circle fill="#FF8210" layoutX="150.0" layoutY="150.0" opacity="0.15" radius="180.0"><effect><GaussianBlur radius="80.0"/></effect></Circle>
        <Circle fill="#679AC1" layoutX="900.0" layoutY="600.0" opacity="0.1" radius="250.0"><effect><GaussianBlur radius="100.0"/></effect></Circle>
    </Pane>

    <BorderPane>
        <left>
            <AnchorPane prefWidth="260.0" styleClass="sidebar-liquid">
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="20.0">
                    <Circle fill="#FF8210" radius="8.0" stroke="WHITE" strokeWidth="2.0"/>
                    <Label styleClass="logo-text" text="GoVacate"/>
                </HBox>

                <VBox fx:id="menuContainer" layoutY="140.0" spacing="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <Button fx:id="btnExplorer" onAction="#showExplorer" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Explorer"/>
                    <Button fx:id="btnMesReservations" onAction="#showReservations" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Mes Réservations"/>
                    <Button fx:id="btnMesFactures" onAction="#showFactures" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Mes Factures"/>
                    <Button fx:id="btnChat" onAction="#showChat" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Support Client 💬"/>

                    <Pane prefHeight="50.0" mouseTransparent="true"/>
                    <Button fx:id="btnLogout" onAction="#handleLogout" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Déconnexion"/>
                </VBox>
            </AnchorPane>
        </left>

        <center>
            <StackPane>
                <ScrollPane fx:id="explorerView" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane">
                    <VBox spacing="40.0">
                        <padding><Insets bottom="50.0" left="50.0" right="50.0" top="40.0"/></padding>
                        <Label styleClass="text-header" text="Bonjour, Voyageur"/>
                        <VBox alignment="CENTER" spacing="25.0" styleClass="glass-panel">
                            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
                            <Label styleClass="hero-title" text="Votre prochaine destination ?"/>
                            <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" styleClass="search-bar-liquid">
                                <TextField promptText="Maldives..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                                <Button styleClass="btn-orange-glow" text="Plonger"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <VBox fx:id="clientReservationView" spacing="25.0" visible="false" styleClass="view-container">
                    <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/></padding>
                    <Label styleClass="text-header" text="Mes Réservations" />
                    <TableView fx:id="tableMesReservations" VBox.vgrow="ALWAYS" styleClass="admin-table">
                        <columns>
                            <TableColumn fx:id="colResType" text="EXPÉRIENCE" prefWidth="200"/>
                            <TableColumn fx:id="colResDate" text="DATE" prefWidth="150"/>
                            <TableColumn fx:id="colResPrix" text="PRIX (DT)" prefWidth="100"/>
                            <TableColumn fx:id="colResStatut" text="STATUT" prefWidth="140"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox fx:id="clientFactureView" spacing="25.0" visible="false" styleClass="view-container">
                    <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/></padding>
                    <VBox spacing="5">
                        <Label styleClass="text-header" text="Mes Factures" />
                        <Label style="-fx-text-fill: #679AC1;" text="Téléchargez vos reçus au format PDF" />
                    </VBox>
                    <TableView fx:id="tableClientFactures" VBox.vgrow="ALWAYS" styleClass="admin-table">
                        <columns>
                            <TableColumn fx:id="colFactDate" text="DATE" prefWidth="150"/>
                            <TableColumn fx:id="colFactMontant" text="MONTANT (DT)" prefWidth="120"/>
                            <TableColumn fx:id="colFactMethode" text="PAIEMENT" prefWidth="120"/>
                            <TableColumn fx:id="colFactAction" text="ACTIONS" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox fx:id="clientChatView" spacing="20.0" visible="false" styleClass="view-container">
                    <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/></padding>
                    <Label styleClass="text-header" text="Support en direct" />
                    <TextArea fx:id="chatDisplay" editable="false" prefHeight="400.0" styleClass="glass-panel" wrapText="true" VBox.vgrow="ALWAYS" />
                    <HBox spacing="10.0">
                        <TextField fx:id="chatInput" onAction="#handleSendMessage" promptText="Écrivez votre message ici..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleSendMessage" styleClass="btn-orange-glow" text="Envoyer" />
                    </HBox>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>