<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.collections.FXCollections?>

<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.RestaurantController" stylesheets="/css/client_style.css">
    <left>
        <VBox fx:id="filterPanel" spacing="16" style="-fx-padding:24; -fx-background-color: white; -fx-border-color: transparent;" prefWidth="300">
            <Text text="Filtres" styleClass="section-title" />

            <VBox spacing="8">
                <Label text="Catégorie" />
                <ComboBox fx:id="categoryFilter" promptText="Toutes" />
            </VBox>

            <VBox spacing="8">
                <Label text="Note minimale" />
                <Slider fx:id="ratingFilter" min="0" max="5" value="3" blockIncrement="0.5" />
            </VBox>

            <VBox spacing="8">
                <Label text="Trier par" />
                <ComboBox fx:id="sortBox">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Pertinence" />
                            <String fx:value="Note" />
                            <String fx:value="Vues" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>

            <HBox spacing="10">
                <Button fx:id="applyFilters" text="Appliquer" styleClass="btn-cta" />
                <Button fx:id="clearFilters" text="Réinitialiser" />
            </HBox>

        </VBox>
    </left>

    <center>
        <VBox spacing="14" style="-fx-padding: 20; -fx-background-color: #f4f6f8;">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 8 0;">
                <Button fx:id="backBtn" text="← Retour" />
                <VBox>
                    <Text text="Restaurants" styleClass="section-title" />
                    <Text text="Découvrez tous les restaurants disponibles" styleClass="section-subtitle" />
                </VBox>
            </HBox>

            <ScrollPane fx:id="listScroll" fitToWidth="true" style="-fx-background-color: transparent;">
                <FlowPane fx:id="restaurantList" hgap="18" vgap="18" prefWrapLength="900" style="-fx-padding:12;" />
            </ScrollPane>

            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding:10 0 0 0;">
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="prevPage" text="Précédent" />
                <Label fx:id="pageLabel" text="Page 1" />
                <Button fx:id="nextPage" text="Suivant" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
