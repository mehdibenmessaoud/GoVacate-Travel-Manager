<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="600.0" prefWidth="450.0" spacing="0" styleClass="chat-container" stylesheets="@css/client_style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.ChatAIController">

    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="chat-header">
        <padding>
            <Insets bottom="15" left="20" right="20" top="15" />
        </padding>
        <children>
            <Circle fx:id="aiStatusCircle" fill="#2ecc71" radius="6.0" />
            <VBox>
                <Label style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 16;" text="GoVacate AI Assistant" />
                <Label style="-fx-text-fill: #adb5bd; -fx-font-size: 11;" text="Recommandations intelligentes" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleClearChat" styleClass="btn-icon" text="&#x1F5D1;" />
        </children>
    </HBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="chat-scroll" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="chatBox" spacing="15">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>
            </VBox>
        </content>
    </ScrollPane>

    <HBox alignment="CENTER" spacing="10" styleClass="chat-input-area">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>
        <children>
            <TextField fx:id="userInputField" onAction="#handleSendMessage" prefHeight="45.0" promptText="Ex: Budget 1000 DT, destination Djerba..." styleClass="modern-textfield" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSend" onAction="#handleSendMessage" prefHeight="45.0" prefWidth="80.0" styleClass="btn-orange-glow" text="Envoyer" />
        </children>
    </HBox>
</VBox>
