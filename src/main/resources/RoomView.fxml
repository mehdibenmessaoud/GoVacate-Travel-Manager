<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="detailViewSection" managed="false" spacing="25.0" visible="false"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.projet.gui.AdminDetailSectionController">

    <Button fx:id="backButton" styleClass="btn-back" text="Retour a la liste"/>

    <HBox alignment="TOP_LEFT" spacing="30.0">
        <VBox prefWidth="520.0" spacing="15.0">
            <StackPane fx:id="mainImageContainer" prefHeight="330.0" styleClass="detail-media-frame">
                <ImageView fx:id="mainImageView" fitHeight="330.0" fitWidth="520.0" preserveRatio="true"/>
            </StackPane>
            <HBox fx:id="thumbnailsContainer" alignment="CENTER_LEFT" spacing="10.0"/>
        </VBox>

        <VBox spacing="18.0" styleClass="glass-card" HBox.hgrow="ALWAYS">
            <Label fx:id="detailName" styleClass="text-header"/>
            <Label fx:id="detailSubInfo" styleClass="text-sub"/>
            <HBox fx:id="detailApiRow" alignment="CENTER_LEFT" spacing="8.0"/>
            <FlowPane fx:id="detailBadges" hgap="12.0" vgap="10.0"/>
            <Label fx:id="detailDesc" styleClass="detail-desc-label" wrapText="true"/>
            <FlowPane fx:id="detailActionButtons" alignment="CENTER_LEFT" hgap="12.0" prefWrapLength="620.0" vgap="12.0">
                <padding>
                    <Insets top="15.0"/>
                </padding>
            </FlowPane>
        </VBox>
    </HBox>

    <VBox fx:id="detailServicesSection" spacing="10.0" styleClass="glass-card">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label fx:id="detailServicesTitle" styleClass="hero-title" text="Services de l'hotel"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="detailManageServicesBtn" text="Gerer services"/>
        </HBox>
        <FlowPane fx:id="detailServicesPane" hgap="10.0" prefWrapLength="1080.0" vgap="10.0"/>
    </VBox>

    <VBox fx:id="reviewsSection" spacing="15.0" styleClass="glass-card">
        <HBox alignment="CENTER_LEFT">
            <Label styleClass="hero-title" text="Avis clients"/>
        </HBox>
        <TableView fx:id="reviewsTable" minHeight="150.0" prefHeight="200.0" styleClass="admin-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colReviewRating" minWidth="120.0" prefWidth="150.0" text="Note"/>
                <TableColumn fx:id="colReviewComment" minWidth="250.0" prefWidth="350.0" text="Commentaire"/>
                <TableColumn fx:id="colReviewUser" minWidth="140.0" prefWidth="180.0" text="Utilisateur"/>
                <TableColumn fx:id="colReviewActions" minWidth="180.0" prefWidth="220.0" text="Actions"/>
            </columns>
        </TableView>
    </VBox>

    <VBox fx:id="imagesSection" spacing="15.0" styleClass="glass-card">
        <HBox alignment="CENTER_LEFT">
            <Label styleClass="hero-title" text="Gestion des images"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="addImageBtn" styleClass="btn-orange-glow" text="+ Ajouter image"/>
        </HBox>
        <TableView fx:id="imagesTable" minHeight="120.0" prefHeight="180.0" styleClass="admin-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colImagePath" minWidth="300.0" prefWidth="450.0" text="Chemin de l'image"/>
                <TableColumn fx:id="colImagePreview" minWidth="100.0" prefWidth="150.0" text="Apercu"/>
                <TableColumn fx:id="colImageActions" minWidth="120.0" prefWidth="150.0" text="Actions"/>
            </columns>
        </TableView>
    </VBox>

    <VBox fx:id="roomImagesSection" managed="false" spacing="15.0" styleClass="glass-card" visible="false">
        <HBox alignment="CENTER_LEFT">
            <Label styleClass="hero-title" text="Gestion des images"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="addRoomImageBtn" styleClass="btn-orange-glow" text="+ Ajouter image"/>
        </HBox>
        <TableView fx:id="roomImagesTable" minHeight="120.0" prefHeight="180.0" styleClass="admin-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colRoomImagePath" minWidth="300.0" prefWidth="450.0" text="Chemin de l'image"/>
                <TableColumn fx:id="colRoomImagePreview" minWidth="100.0" prefWidth="150.0" text="Apercu"/>
                <TableColumn fx:id="colRoomImageActions" minWidth="120.0" prefWidth="150.0" text="Actions"/>
            </columns>
        </TableView>
    </VBox>
</VBox>

