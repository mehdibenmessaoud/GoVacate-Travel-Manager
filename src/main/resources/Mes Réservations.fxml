<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<AnchorPane fx:id="rootPane" prefHeight="700.0" prefWidth="950.0" minHeight="700.0" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.projet.gui.MesReservationsController">

    <stylesheets>
        <URL value="@/css/mes_reservations.css" />
    </stylesheets>

    <children>
        <VBox prefHeight="130.0" styleClass="sidebar-liquid" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox alignment="CENTER_LEFT" prefHeight="130.0" spacing="20.0">
                <padding><Insets left="40.0" right="40.0" /></padding>
                <VBox alignment="CENTER_LEFT">
                    <Label text="TRAVEL AGENCY" styleClass="text-sub" style="-fx-font-size: 10; -fx-font-weight: 900;"/>
                    <Label text="Mes Réservations" styleClass="logo-text" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="155.0">

            <HBox spacing="20.0" alignment="CENTER_LEFT" prefHeight="70.0">
                <padding><Insets left="10.0" right="10.0" /></padding>
                <children>
                    <HBox alignment="CENTER_LEFT" styleClass="glass-panel-search" prefWidth="400.0" prefHeight="45.0">
                        <padding><Insets left="15.0" right="15.0" /></padding>
                        <children>
                            <Label text="🔍" style="-fx-text-fill: #679AC1; -fx-font-size: 16px;" />
                            <TextField fx:id="searchField" promptText="Rechercher une expérience..."
                                       HBox.hgrow="ALWAYS" styleClass="transparent-field" />
                        </children>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER_LEFT" styleClass="glass-panel-search" prefWidth="250.0" prefHeight="45.0">
                        <padding><Insets left="15.0" right="5.0" /></padding>
                        <children>
                            <Label text="📌" style="-fx-text-fill: #00FFFF; -fx-font-size: 14px;" />
                            <ComboBox fx:id="statusFilterCombo" HBox.hgrow="ALWAYS" prefWidth="200.0" styleClass="custom-combo" />
                        </children>
                    </HBox>
                </children>
            </HBox>

            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="glass-card"> <TableView fx:id="tableMesReservations" styleClass="admin-table">
                <columns>
                    <TableColumn fx:id="colType" prefWidth="150.0" text="EXPÉRIENCE" />
                    <TableColumn fx:id="colDate" prefWidth="200.0" text="DATE &amp; HEURE" />
                    <TableColumn fx:id="colPrix" prefWidth="100.0" text="PRIX (DT)" />
                    <TableColumn fx:id="colStatut" prefWidth="120.0" text="STATUT" />
                    <TableColumn fx:id="colTicket" prefWidth="120.0" text="TICKET" />
                    <TableColumn fx:id="colAction" prefWidth="220.0" text="GESTION" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 0 20 0;">
                <Button onAction="#handlePayerSelection" prefHeight="55.0" prefWidth="320.0"
                        styleClass="btn-orange-glow"
                        style="-fx-background-color: #FF8210; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 30; -fx-cursor: hand;"
                        text="PROCÉDER AU PAIEMENT" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>