<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" styleClass="main-content" stylesheets="@css/client_style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.ExcursionDetailsController">
    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
    </padding>

    <VBox spacing="20.0" styleClass="glass-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Button onAction="#handleBack" styleClass="btn-orange-glow" text="← Retour" />
                <VBox>
                    <Label fx:id="nameLabel" styleClass="details-title" text="Nom de l'Excursion" />
                    <Label fx:id="activiteLabel" styleClass="details-subtitle" text="Type d'activité" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER" prefWidth="150" spacing="10" styleClass="glass-card">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>
                    <children> <Label styleClass="text-sub" text="Météo locale" />
                        <ImageView fx:id="weatherIcon" fitHeight="50" fitWidth="50" preserveRatio="true" />
                        <Label fx:id="tempLabel" style="-fx-font-size: 22; -fx-text-fill: #FF8210; -fx-font-weight: bold;" text="--°C" />
                        <Label fx:id="descLabel" styleClass="text-sub" text="Chargement..." />
                    </children>
                </VBox>
                <Label fx:id="statusLabel" styleClass="status-badge-details" text="Disponible" />
            </HBox>

            <Separator opacity="0.2" />

            <VBox spacing="10.0">
                <Label styleClass="section-label" text="Galerie Photos" />
                <ScrollPane fitToHeight="true" minHeight="250.0" prefHeight="250.0" styleClass="image-carousel-scroll" vbarPolicy="NEVER">
                    <content>
                        <HBox fx:id="imageContainer" alignment="CENTER_LEFT" spacing="15.0" styleClass="image-hbox-padding" />
                    </content>
                </ScrollPane>
            </VBox>

            <GridPane hgap="30.0" vgap="20.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                <children>
                    <VBox spacing="5.0">
                        <Label styleClass="meta-label" text="Période" />
                        <Label fx:id="datesLabel" styleClass="meta-value" text="Dates non spécifiées" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="1">
                        <Label styleClass="meta-label" text="Prix par personne" />
                        <Label fx:id="priceLabel" styleClass="meta-price" text="0.00 DT" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.rowIndex="1">
                        <Label styleClass="meta-label" text="Durée estimée" />
                        <Label fx:id="durationLabel" styleClass="meta-value" text="4 Heures" />
                    </VBox>

                    <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label styleClass="meta-label" text="Capacité Maximum" />
                        <Label fx:id="maxParticipantsLabel" styleClass="meta-value" text="20 personnes" />
                    </VBox>
                </children>
            </GridPane>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <Label styleClass="meta-label" text="Description de l'excursion" />
                <ScrollPane fitToWidth="true" styleClass="transparent-scroll">
                    <content>
                        <Text fx:id="descriptionLabel" styleClass="details-description" text="Détails complets ici..." wrappingWidth="800.0" />
                    </content>
                </ScrollPane>
            </VBox>
        </children>
    </VBox>
</VBox>