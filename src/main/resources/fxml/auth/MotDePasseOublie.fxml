<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" minHeight="600.0" minWidth="900.0" prefHeight="700.0" prefWidth="1000.0"
           styleClass="root-container" maxHeight="900.0" maxWidth="1400.0"
           xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.projet.gui.auth.MotDePasseOublieController">

    <VBox alignment="CENTER" maxWidth="520.0" prefWidth="520.0" minWidth="480.0" spacing="22.0" style="-fx-padding: 55 50; -fx-background-color: white; -fx-background-radius: 15;">
        <effect>
            <DropShadow color="#00000030" radius="20" blurType="GAUSSIAN"/>
        </effect>

        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 0 0 20 0;">
            <HBox alignment="CENTER" spacing="12">
                <Rectangle arcHeight="15.0" arcWidth="15.0" fill="#FF8210" height="45.0" width="45.0" />
                <Text text="GoVacate" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #00447B;"/>
            </HBox>
        </VBox>

        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 0 0 22 0;">
            <Text text="Mot de passe oublié" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #1a1a1a;"/>
            <Text text="Réinitialisez votre mot de passe en toute sécurité" style="-fx-font-size: 14; -fx-fill: #6C6D6F;"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 0 0 25 0;">
            <Circle fx:id="step1Circle" radius="8" fill="#FF8210"/>
            <Line endX="40" stroke="#C0C0C0"/>
            <Circle fx:id="step2Circle" radius="8" fill="#C0C0C0"/>
            <Line endX="40" stroke="#C0C0C0"/>
            <Circle fx:id="step3Circle" radius="8" fill="#C0C0C0"/>
        </HBox>

        <Label fx:id="errorLabel" textFill="#E74C3C" visible="false" wrapText="true" prefWidth="400" maxWidth="400" alignment="CENTER" style="-fx-font-size: 12px; -fx-padding: 0 0 8 0;"/>

        <!-- Step 1: Email Input -->
        <VBox fx:id="step1Box" spacing="16" alignment="CENTER" prefWidth="400" maxWidth="400">
            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 12 0;">
                <Text text="Étape 1: Entrez votre adresse email" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #00447B;"/>
                <Text text="Nous enverrons un code de vérification à cette adresse si elle est associée à un compte."
                      style="-fx-font-size: 13; -fx-fill: #6C6D6F; -fx-text-alignment: center;" wrappingWidth="380" textAlignment="CENTER"/>
            </VBox>
            <TextField fx:id="emailField" promptText="votre@email.com"
                       styleClass="text-field-pro" prefWidth="400" maxWidth="400"/>
        </VBox>

        <!-- Step 2: Verification Code -->
        <VBox fx:id="step2Box" spacing="16" alignment="CENTER" prefWidth="400" maxWidth="400" visible="false" managed="false">
            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 12 0;">
                <Text text="Étape 2: Code de Vérification" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #00447B;"/>
                <Text text="Un code de sécurité a été envoyé à :"
                      style="-fx-font-size: 13; -fx-fill: #6C6D6F; -fx-text-alignment: center;" wrappingWidth="380" textAlignment="CENTER"/>
                <Label fx:id="emailDisplayLabel" style="-fx-font-weight: bold; -fx-text-fill: #FF8210; -fx-font-size: 14; -fx-padding: 5 0 0 0;"/>
                <Label fx:id="devCodeLabel" visible="false" managed="false" wrapText="true" prefWidth="380" maxWidth="380"
                       style="-fx-font-size: 13; -fx-text-fill: #27AE60; -fx-font-weight: bold; -fx-padding: 10; -fx-background-color: #E8F5E9;"/>
            </VBox>
            <TextField fx:id="codeField" promptText="Entrez le code à 6 chiffres"
                       styleClass="text-field-pro" prefWidth="400" maxWidth="400"/>
            <Hyperlink text="Renvoyer le code" onAction="#resendCode" style="-fx-text-fill: #00447B; -fx-font-size: 12px; -fx-underline: false;"/>
        </VBox>

        <!-- Step 3: New Password -->
        <VBox fx:id="step3Box" spacing="16" alignment="CENTER" prefWidth="400" maxWidth="400" visible="false" managed="false">
            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 12 0;">
                <Text text="Étape 3: Définir un nouveau mot de passe" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #00447B;"/>
                <Text text="Choisissez un mot de passe fort que vous n'utilisez nulle part ailleurs."
                      style="-fx-font-size: 13; -fx-fill: #6C6D6F; -fx-text-alignment: center;" wrappingWidth="380" textAlignment="CENTER"/>
            </VBox>
            <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"
                           styleClass="text-field-pro" prefWidth="400" maxWidth="400"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe"
                           styleClass="text-field-pro" prefWidth="400" maxWidth="400"/>
            <Text text="Doit contenir au moins 6 caractères."
                  style="-fx-font-size: 11px; -fx-fill: #A0A0A0;"/>
        </VBox>

        <HBox spacing="14" alignment="CENTER" style="-fx-padding: 22 0 0 0;">
            <Button text="Retour" onAction="#handleBack" styleClass="btn-outline-orange-pro" prefHeight="44" prefWidth="130"/>
            <Button fx:id="actionButton" text="VÉRIFIER EMAIL" onAction="#handleAction"
                    prefHeight="44" prefWidth="200" styleClass="btn-orange-pro"/>
        </HBox>
    </VBox>
</StackPane>
