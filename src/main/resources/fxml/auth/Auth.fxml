<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" minHeight="600.0" minWidth="900.0" prefHeight="700.0" prefWidth="1000.0"
           styleClass="root-container" maxHeight="900.0" maxWidth="1400.0"
           xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.projet.gui.auth.AuthController">

    <StackPane alignment="CENTER" prefWidth="1000" prefHeight="700" minWidth="1000" minHeight="650"
               maxWidth="1000" maxHeight="700" style="-fx-background-color: #F4F4F4; -fx-background-radius: 15;"
               styleClass="auth-card-clip">
        <effect>
            <DropShadow color="#00000030" radius="20" blurType="GAUSSIAN"/>
        </effect>

        <HBox alignment="CENTER_LEFT" fillHeight="true" spacing="0" maxWidth="1000" minWidth="1000">
            <!-- Login Section -->
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" prefWidth="500.0" minWidth="500.0" maxWidth="500.0"
                  spacing="22.0" style="-fx-background-color: white; -fx-background-radius: 15 0 0 15;">
                <padding>
                    <Insets top="45" right="55" bottom="45" left="55"/>
                </padding>

                <VBox alignment="CENTER" spacing="6" style="-fx-padding: 0 0 20 0;">
                    <HBox alignment="CENTER" spacing="12">
                        <Rectangle arcHeight="15.0" arcWidth="15.0" fill="#FF8210" height="48.0" width="48.0" />
                        <Text text="GoVacate" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #00447B;"/>
                    </HBox>
                </VBox>

                <VBox alignment="CENTER" spacing="6" style="-fx-padding: 0 0 22 0;">
                    <Text text="Bon Retour !" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #1a1a1a;" />
                    <Text text="Connectez-vous à votre compte" style="-fx-font-size: 14; -fx-fill: #6C6D6F;" />
                </VBox>

                <VBox spacing="16" prefWidth="360" maxWidth="360" alignment="CENTER">
                    <TextField fx:id="loginEmail" promptText="Adresse email" styleClass="text-field-pro" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                    <HBox spacing="0" alignment="CENTER_LEFT" prefWidth="360" maxWidth="360">
                        <StackPane HBox.hgrow="ALWAYS" prefWidth="360" maxWidth="360">
                            <PasswordField fx:id="loginPass" promptText="Mot de passe" styleClass="text-field-pro" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                            <TextField fx:id="loginPassVisible" promptText="Mot de passe" styleClass="text-field-pro" visible="false" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                        </StackPane>
                        <Button fx:id="toggleLoginPass" styleClass="toggle-pass-btn" text="👁" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-translate-x: -40;"/>
                    </HBox>
                    <Label fx:id="loginErrorLabel" visible="false" style="-fx-text-fill: #E74C3C; -fx-font-size: 12px;" wrapText="true" prefWidth="360" maxWidth="360" alignment="CENTER"/>
                </VBox>

                <VBox alignment="CENTER" spacing="14" style="-fx-padding: 8 0 0 0;">
                    <Button onAction="#processLogin" prefHeight="44.0" prefWidth="360" maxWidth="360" styleClass="btn-orange-pro" text="SE CONNECTER" />
                    <Hyperlink text="Mot de passe oublié ?" onAction="#goToMotDePasseOublie"
                               style="-fx-text-fill: #00447B; -fx-font-size: 13px; -fx-underline: false;"/>
                </VBox>
            </VBox>

            <!-- Registration Section -->
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" prefWidth="500.0" minWidth="500.0" maxWidth="500.0"
                  spacing="18.0" style="-fx-background-color: #F8F9FA; -fx-background-radius: 0 15 15 0;">
                <padding>
                    <Insets top="45" right="55" bottom="45" left="55"/>
                </padding>
                
                <VBox alignment="CENTER" spacing="6" style="-fx-padding: 0 0 18 0;">
                    <Text text="Créer un Compte" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #1a1a1a;" />
                    <Text text="Rejoignez-nous pour planifier vos vacances" style="-fx-font-size: 14; -fx-fill: #6C6D6F;" />
                </VBox>

                <VBox spacing="12" prefWidth="360" maxWidth="360" alignment="CENTER">
                    <TextField fx:id="signName" promptText="Nom complet" styleClass="text-field-pro" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                    <TextField fx:id="signEmail" promptText="Adresse email" styleClass="text-field-pro" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                    <TextField fx:id="signTel" promptText="Téléphone" styleClass="text-field-pro" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                    <DatePicker fx:id="signDate" promptText="Date de naissance" styleClass="date-picker-pro" prefWidth="360" maxWidth="360"/>

                    <HBox spacing="0" alignment="CENTER_LEFT" prefWidth="360" maxWidth="360">
                        <StackPane HBox.hgrow="ALWAYS" prefWidth="360" maxWidth="360">
                            <PasswordField fx:id="signPass" promptText="Mot de passe" styleClass="text-field-pro" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                            <TextField fx:id="signPassVisible" promptText="Mot de passe" styleClass="text-field-pro" visible="false" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                        </StackPane>
                        <Button fx:id="toggleSignPass" styleClass="toggle-pass-btn" text="👁" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-translate-x: -40;"/>
                    </HBox>

                    <Label fx:id="passwordStrengthLabel" styleClass="password-strength-label" visible="false" wrapText="true" prefWidth="360" maxWidth="360" alignment="CENTER"/>

                    <HBox spacing="0" alignment="CENTER_LEFT" prefWidth="360" maxWidth="360">
                        <StackPane HBox.hgrow="ALWAYS" prefWidth="360" maxWidth="360">
                            <PasswordField fx:id="signPassConfirm" promptText="Confirmer le mot de passe" styleClass="text-field-pro" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                            <TextField fx:id="signPassConfirmVisible" promptText="Confirmer le mot de passe" styleClass="text-field-pro" visible="false" prefWidth="360" maxWidth="360" style="-fx-padding: 12 15;"/>
                        </StackPane>
                        <Button fx:id="toggleSignPassConfirm" styleClass="toggle-pass-btn" text="👁" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-translate-x: -40;"/>
                    </HBox>

                    <Label fx:id="registerErrorLabel" visible="false" style="-fx-text-fill: #E74C3C; -fx-font-size: 12px;" wrapText="true" prefWidth="360" maxWidth="360" alignment="CENTER"/>
                </VBox>

                <VBox alignment="CENTER" spacing="14" style="-fx-padding: 8 0 0 0;">
                    <Button onAction="#processRegister" prefHeight="44.0" prefWidth="360" maxWidth="360" styleClass="btn-orange-pro" text="S'INSCRIRE" />
                    <HBox alignment="CENTER" spacing="8">
                        <Text text="Déjà inscrit ?" style="-fx-font-size: 12; -fx-fill: #6C6D6F;" />
                        <Button onAction="#handleSwitch" styleClass="btn-outline-orange-pro" text="Se connecter" prefHeight="35.0" prefWidth="130.0"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>

        <Pane fx:id="slidingPane" prefWidth="500.0" minWidth="500.0" maxWidth="500.0" styleClass="side-pane" StackPane.alignment="CENTER_RIGHT">
            <VBox alignment="CENTER" prefHeight="700.0" prefWidth="500.0" minHeight="650.0" spacing="36.0"
                  style="-fx-padding: 55 50 55 50;">
                <VBox alignment="CENTER" spacing="16">
                    <Text fx:id="overlayTitle" style="-fx-font-size: 30; -fx-fill: white; -fx-font-weight: bold; -fx-text-alignment: center;" text="Nouveau Voyageur ?" />
                    <Text fx:id="overlayText" style="-fx-fill: #EAEAEA; -fx-text-alignment: center; -fx-font-size: 15;"
                          text="Inscrivez-vous dès aujourd'hui et commencez à planifier vos prochaines vacances." wrappingWidth="340" textAlignment="CENTER"/>
                </VBox>
                <Button fx:id="switchBtn" onAction="#handleSwitch" prefHeight="48.0" prefWidth="240.0" styleClass="btn-outline-white-pro" text="CRÉER UN COMPTE" />
            </VBox>
        </Pane>
    </StackPane>
</StackPane>
