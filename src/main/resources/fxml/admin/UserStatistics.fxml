<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="750" prefWidth="1100"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.projet.gui.admin.UserStatisticsController">

    <!-- Background Gradient (Dark Theme) -->
    <Region style="-fx-background-color: linear-gradient(to bottom right, #001F3F, #003366);"/>

    <VBox spacing="25" styleClass="admin-content-area" stylesheets="@../../css/admin-dashboard-style.css">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <VBox>
                <Label text="Statistiques Utilisateurs" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 1);"/>
                <Label text="Vue d'ensemble de l'activité et de la répartition" style="-fx-text-fill: #679AC1; -fx-font-size: 14;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="↻ Rafraîchir" onAction="#handleRefresh" styleClass="btn-secondary"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;"/>
        </HBox>

        <Separator opacity="0.2" style="-fx-background-color: white;"/>

        <!-- Key Metrics Cards -->
        <FlowPane hgap="20" vgap="20" prefWrapLength="1000">
            <!-- Total Users -->
            <VBox styleClass="glass-card" prefWidth="200" spacing="5"
                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                <Label text="TOTAL UTILISATEURS" style="-fx-text-fill: #bdc3c7; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <Label fx:id="totalUsersLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Circle radius="3" fill="#3498db"/>
                    <Label text="Inscrits" style="-fx-text-fill: #3498db; -fx-font-size: 11;"/>
                </HBox>
            </VBox>

            <!-- Active Accounts -->
            <VBox styleClass="glass-card" prefWidth="200" spacing="5"
                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                <Label text="COMPTES ACTIFS" style="-fx-text-fill: #bdc3c7; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <Label fx:id="activeCountLabel" text="0" style="-fx-text-fill: #2ecc71; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Circle radius="3" fill="#2ecc71"/>
                    <Label text="En règle" style="-fx-text-fill: #2ecc71; -fx-font-size: 11;"/>
                </HBox>
            </VBox>

            <!-- Admins -->
            <VBox styleClass="glass-card" prefWidth="200" spacing="5"
                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                <Label text="ADMINISTRATEURS" style="-fx-text-fill: #bdc3c7; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <Label fx:id="adminCountLabel" text="0" style="-fx-text-fill: #e67e22; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Circle radius="3" fill="#e67e22"/>
                    <Label text="Gestionnaires" style="-fx-text-fill: #e67e22; -fx-font-size: 11;"/>
                </HBox>
            </VBox>

            <!-- Clients -->
            <VBox styleClass="glass-card" prefWidth="200" spacing="5"
                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                <Label text="CLIENTS" style="-fx-text-fill: #bdc3c7; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <Label fx:id="clientCountLabel" text="0" style="-fx-text-fill: #9b59b6; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Circle radius="3" fill="#9b59b6"/>
                    <Label text="Voyageurs" style="-fx-text-fill: #9b59b6; -fx-font-size: 11;"/>
                </HBox>
            </VBox>

            <!-- Active Sessions -->
            <VBox styleClass="glass-card" prefWidth="200" spacing="5"
                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                <Label text="SESSIONS ACTIVES" style="-fx-text-fill: #bdc3c7; -fx-font-size: 10; -fx-font-weight: bold;"/>
                <Label fx:id="activeSessionsLabel" text="0" style="-fx-text-fill: #f1c40f; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Circle radius="3" fill="#f1c40f"/>
                    <Label text="En ligne maintenant" style="-fx-text-fill: #f1c40f; -fx-font-size: 11;"/>
                </HBox>
            </VBox>
        </FlowPane>

        <!-- Charts Section -->
        <HBox spacing="25" VBox.vgrow="ALWAYS">
            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="glass-card"
                  style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 20; -fx-padding: 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 20;">
                <Label text="Répartition par Rôle" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>
                <PieChart fx:id="roleChart" styleClass="chart-pie-label-line" legendVisible="true" labelsVisible="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="glass-card"
                  style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 20; -fx-padding: 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 20;">
                <Label text="Statut des Comptes" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>
                <PieChart fx:id="statusChart" styleClass="chart-pie-label-line" legendVisible="true" labelsVisible="true" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>

        <!-- Recent Users Table -->
        <VBox spacing="10" VBox.vgrow="ALWAYS"
              style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 20; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 20;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Derniers Inscrits" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="5 plus récents" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11;"/>
            </HBox>

            <TableView fx:id="recentUsersTable" prefHeight="150" styleClass="admin-table" style="-fx-background-color: transparent;">
                <columns>
                    <TableColumn fx:id="colRecentNom" text="Nom" prefWidth="250"/>
                    <TableColumn fx:id="colRecentRole" text="Rôle" prefWidth="150"/>
                    <TableColumn fx:id="colRecentDate" text="Date d'inscription" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</StackPane>
