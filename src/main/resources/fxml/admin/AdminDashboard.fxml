<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<StackPane prefHeight="700" prefWidth="1000"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.projet.gui.admin.AdminDashboardController">

    <!-- Background with Gradient -->
    <Region style="-fx-background-color: linear-gradient(to bottom right, #1a252f, #2c3e50);"/>

    <VBox spacing="30" styleClass="admin-main-container" stylesheets="@../../css/admin-dashboard-style.css">
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox HBox.hgrow="ALWAYS" spacing="5">
                <Label text="Tableau de Bord" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 0);"/>
                <Label text="Administration GoVacate" style="-fx-text-fill: #bdc3c7; -fx-font-size: 16;"/>
            </VBox>

            <!-- Admin Profile Badge -->
            <HBox spacing="15" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 30; -fx-padding: 10 20;">
                <Circle radius="22" fill="#3498db" stroke="WHITE" strokeWidth="2"/>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="adminNameLabel" text="Admin" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Circle radius="4" fill="#2ecc71"/>
                        <Label text="En ligne" style="-fx-text-fill: #2ecc71; -fx-font-size: 11;"/>
                    </HBox>
                </VBox>
            </HBox>
        </HBox>

        <Separator opacity="0.2" style="-fx-background-color: white;"/>

        <!-- Dashboard Cards -->
        <FlowPane hgap="30" vgap="30" prefWrapLength="900">

            <!-- User Management Card -->
            <VBox onMouseClicked="#handleUserManagement" styleClass="action-card" spacing="20" prefWidth="300" prefHeight="200"
                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15; -fx-border-width: 1;">
                <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                <effect>
                    <DropShadow color="#00000040" radius="10" offsetY="5"/>
                </effect>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane>
                        <Circle radius="30" fill="rgba(230, 126, 34, 0.2)"/>
                        <Label text="👥" style="-fx-font-size: 24; -fx-text-fill: #e67e22;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Utilisateurs" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                        <Label text="Gestion des comptes" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;"/>
                    </VBox>
                </HBox>

                <Label text="Gérer les accès, modifier les profils et surveiller l'activité des utilisateurs."
                       wrapText="true" style="-fx-text-fill: #bdc3c7; -fx-font-size: 13;"/>

                <HBox alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                    <Label text="Accéder →" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Analytics Card -->
            <VBox onMouseClicked="#handleStatistics" styleClass="action-card" spacing="20" prefWidth="300" prefHeight="200"
                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15; -fx-border-width: 1;">
                <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                <effect>
                    <DropShadow color="#00000040" radius="10" offsetY="5"/>
                </effect>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane>
                        <Circle radius="30" fill="rgba(46, 204, 113, 0.2)"/>
                        <Label text="📊" style="-fx-font-size: 24; -fx-text-fill: #2ecc71;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Analytiques" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                        <Label text="Statistiques globales" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;"/>
                    </VBox>
                </HBox>

                <Label text="Visualiser les performances, les rapports de ventes et les tendances."
                       wrapText="true" style="-fx-text-fill: #bdc3c7; -fx-font-size: 13;"/>

                <HBox alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                    <Label text="Voir les stats →" style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

        </FlowPane>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Footer Actions -->
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Button text="👤 Mon Profil" onAction="#handleProfile" styleClass="btn-secondary"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand;"/>
            <Button text="🚪 Déconnexion" onAction="#handleLogout" styleClass="btn-danger"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</StackPane>
