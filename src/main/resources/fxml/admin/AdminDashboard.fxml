<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox spacing="30" prefHeight="700" prefWidth="1000"
      styleClass="admin-main-container"
      stylesheets="@../../css/admin-dashboard-style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.projet.gui.admin.AdminDashboardController">

    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox HBox.hgrow="ALWAYS" spacing="5">
            <Label text="Tableau de bord" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Bienvenue dans votre espace d'administration GoVacate" style="-fx-text-fill: #679AC1; -fx-font-size: 14;"/>
        </VBox>
        <HBox spacing="15" alignment="CENTER">
            <Circle radius="20" fill="#2D4A6E" stroke="WHITE" strokeWidth="1"/>
            <VBox alignment="CENTER_LEFT">
                <Label fx:id="adminNameLabel" text="Admin Name" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label text="En ligne" style="-fx-text-fill: #27AE60; -fx-font-size: 10;"/>
            </VBox>
        </HBox>
    </HBox>

    <Separator opacity="0.1"/>

    <FlowPane hgap="25" vgap="25">
        <VBox onMouseClicked="#handleUserManagement" styleClass="action-card" spacing="15" prefWidth="280" prefHeight="180">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
            <StackPane alignment="CENTER_LEFT">
                <Circle radius="25" fill="rgba(255, 130, 16, 0.2)"/>
                <Region style="-fx-background-color: #FF8210;" prefWidth="25" prefHeight="25" maxWidth="25" maxHeight="25">
                    <StackPane.margin><Insets left="12"/></StackPane.margin>
                </Region>
            </StackPane>
            <VBox spacing="5">
                <Label text="Utilisateurs" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
                <Label text="Gérer les comptes et accès" style="-fx-text-fill: #679AC1; -fx-font-size: 12;"/>
            </VBox>
        </VBox>

        <VBox onMouseClicked="#handleStatistics" styleClass="action-card" spacing="15" prefWidth="280" prefHeight="180">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
            <StackPane alignment="CENTER_LEFT">
                <Circle radius="25" fill="rgba(39, 174, 96, 0.2)"/>
                <Region style="-fx-background-color: #27AE60;" prefWidth="25" prefHeight="25" maxWidth="25" maxHeight="25">
                    <StackPane.margin><Insets left="12"/></StackPane.margin>
                </Region>
            </StackPane>
            <VBox spacing="5">
                <Label text="Analytiques" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
                <Label text="Rapports et performances" style="-fx-text-fill: #679AC1; -fx-font-size: 12;"/>
            </VBox>
        </VBox>
    </FlowPane>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Mon profil" onAction="#handleProfile" styleClass="btn-secondary" prefHeight="45" prefWidth="140"/>
        <Button text="Déconnexion" onAction="#handleLogout" styleClass="btn-danger" prefHeight="45" prefWidth="140"/>
    </HBox>
</VBox>