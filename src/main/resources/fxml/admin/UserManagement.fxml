<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="700" prefWidth="1100"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.projet.gui.admin.UserManagementController">

    <!-- Background Gradient (Dark Theme) -->
    <Region style="-fx-background-color: linear-gradient(to bottom right, #001F3F, #003366);"/>

    <VBox spacing="20" styleClass="admin-content-area" stylesheets="@../../css/admin-dashboard-style.css">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <VBox>
                <Label text="Gestion des Utilisateurs" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 1);"/>
                <Label text="Administrez les comptes et les permissions" style="-fx-text-fill: #679AC1; -fx-font-size: 14;"/>
            </VBox>
        </HBox>

        <Separator opacity="0.2" style="-fx-background-color: white;"/>

        <!-- Filters Bar -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
            <Label text="🔍" style="-fx-text-fill: white; -fx-font-size: 16;"/>
            <TextField fx:id="searchField" promptText="Rechercher (nom, email)..." prefWidth="300"
                       styleClass="search-input"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Filtrer par :" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12;"/>
            <ComboBox fx:id="roleFilter" promptText="Rôle" prefWidth="150" styleClass="glass-combo"/>
            <ComboBox fx:id="statusFilter" promptText="Statut" prefWidth="150" styleClass="glass-combo"/>
        </HBox>

        <Label fx:id="loadingLabel" text="Chargement des utilisateurs..." visible="false" style="-fx-text-fill: #FF8210; -fx-font-weight: bold;"/>

        <!-- Main Content: Table & Form -->
        <HBox spacing="25" VBox.vgrow="ALWAYS">

            <!-- Table Section (Glassmorphism) -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 20; -fx-padding: 5; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 20;">
                <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
                    <columns>
                        <TableColumn fx:id="colIndex" text="#" prefWidth="50"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="140"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                        <TableColumn fx:id="colRole" text="Rôle" prefWidth="100"/>
                        <TableColumn fx:id="colStatus" text="Statut" prefWidth="100"/>
                        <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Form Section (Side Panel - Glassmorphism) -->
            <VBox spacing="15" prefWidth="350"
                  style="-fx-background-color: rgba(0, 31, 63, 0.8); -fx-background-radius: 20; -fx-padding: 25; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 5);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="5" fill="#FF8210"/>
                    <Label fx:id="formTitle" text="Nouvel Utilisateur" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </HBox>

                <Separator opacity="0.3"/>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <VBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Informations Personnelles" style="-fx-font-size: 11; -fx-text-fill: #679AC1; -fx-font-weight: bold; -fx-text-transform: uppercase;"/>
                            <TextField fx:id="nomField" promptText="Nom complet" styleClass="search-input"/>
                            <TextField fx:id="emailField" promptText="Adresse email" styleClass="search-input"/>
                            <TextField fx:id="telephoneField" promptText="Numéro de téléphone" styleClass="search-input"/>
                            <DatePicker fx:id="dateNaissancePicker" promptText="Date de naissance" prefWidth="350" styleClass="search-input"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Accès &amp; Sécurité" style="-fx-font-size: 11; -fx-text-fill: #679AC1; -fx-font-weight: bold; -fx-text-transform: uppercase;"/>
                            <HBox spacing="10">
                                <ComboBox fx:id="roleCombo" promptText="Rôle" prefWidth="170" styleClass="glass-combo"/>
                                <ComboBox fx:id="statusCombo" promptText="Statut" prefWidth="170" styleClass="glass-combo"/>
                            </HBox>
                            <PasswordField fx:id="passwordField" promptText="Mot de passe" styleClass="search-input"/>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Nouveau" onAction="#handleNew" styleClass="btn-secondary"
                            style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 20;"/>
                    <Button fx:id="deleteButton" text="Supprimer" onAction="#handleDelete" visible="false"
                            style="-fx-background-color: rgba(231, 76, 60, 0.2); -fx-text-fill: #e74c3c; -fx-background-radius: 20; -fx-border-color: #e74c3c; -fx-border-radius: 20; -fx-cursor: hand;"/>
                    <Button fx:id="saveButton" text="ENREGISTRER" onAction="#handleSave" defaultButton="true"
                            styleClass="btn-orange-glow"/>
                </HBox>

                <Button text="Annuler la sélection" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #679AC1; -fx-font-size: 11; -fx-cursor: hand; -fx-underline: true;" alignment="CENTER" maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
