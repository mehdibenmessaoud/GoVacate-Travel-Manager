<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Circle?>

<VBox fx:id="sidebar" prefWidth="260.0" styleClass="sidebar-container"
      stylesheets="@/css/client_style.css"
      spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.projet.gui.SidebarController">

    <padding>
        <Insets bottom="20.0" left="15.0" right="15.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 20 10;">
        <Circle radius="15" fill="#FF8210" />
        <Label text="GoVacate" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: 800;" />
    </HBox>

    <Separator opacity="0.1" style="-fx-padding: 0 0 15 0;" />

    <Label text="MENU PRINCIPAL" styleClass="profile-stat-label" style="-fx-padding: 10 0 5 10;" />

    <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#handleDashboard"
            prefHeight="45.0" prefWidth="230.0" styleClass="profile-tab-btn" text="🏠  Tableau de Bord" />

    <Button fx:id="btnReservations" mnemonicParsing="false" onAction="#handleReservations"
            prefHeight="45.0" prefWidth="230.0" styleClass="profile-tab-btn" text="✈️  Mes Voyages" />

    <Button fx:id="btnExplore" mnemonicParsing="false" onAction="#handleExplore"
            prefHeight="45.0" prefWidth="230.0" styleClass="profile-tab-btn" text="🌍  Explorer" />

    <Separator opacity="0.1" style="-fx-padding: 15 0 15 0;" />

    <Label text="COMPTE" styleClass="profile-stat-label" style="-fx-padding: 0 0 5 10;" />

    <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#handleProfile"
            prefHeight="45.0" prefWidth="230.0" styleClass="profile-tab-btn" text="👤  Mon Profil" />

    <VBox VBox.vgrow="ALWAYS" />

    <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#handleLogout"
            prefHeight="45.0" prefWidth="230.0"
            style="-fx-background-color: rgba(231, 76, 60, 0.15); -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-background-radius: 12;"
            text="🚪  Déconnexion" />

</VBox>