<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="800.0" prefWidth="1200.0" styleClass="main-bg" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.ExcursionBookingController">

    <children>
        <AnchorPane pickOnBounds="false">
            <children>
                <Button onAction="#toggleTheme" text="ðŸŒ“ Mode" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0"
