                    </padding>
                    <children>
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-weight: bold;" styleClass="field-label" text="ðŸ“… Date" textFill="#679AC1" />
                                    <DatePicker fx:id="dateExc" prefHeight="45.0" prefWidth="200.0" promptText="Choisir date" />
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-weight: bold;" styleClass="field-label" text="â° Heure" textFill="#679AC1" />
