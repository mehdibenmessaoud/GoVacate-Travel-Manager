                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnValider" mnemonicParsing="false" onAction="#handleReserverExcursion" prefHeight="55.0" prefWidth="350.0" styleClass="btn-confirm" text="CONFIRMER LA RÃ‰SERVATION">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Button>

                        <Button fx:id="btnAnnuler" managed="false" mnemonicParsing="false" onAction="#handleBack" prefHeight="40.0" prefWidth="350.0" styleClass="btn-cancel" text="ANNULER LES MODIFICATIONS" visible="false">
                        </Button>

                        <Label styleClass="hint-label" text="Explorez les plus beaux paysages avec nos guides" textFill="rgba(255,255,255,0.4)">
