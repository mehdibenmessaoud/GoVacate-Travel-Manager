<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="25.0" styleClass="content-pane" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.RestaurantAdminController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <TextField fx:id="searchField" prefHeight="50.0" promptText="Rechercher par nom, catégorie ou adresse..." HBox.hgrow="ALWAYS" styleClass="search-field-large" />
        <Button onAction="#handleAddRestaurant" prefHeight="50.0" prefWidth="220.0" styleClass="btn-orange-glow" text="+ Ajouter Restaurant" />
    </HBox>

    <TableView fx:id="restaurantTable" VBox.vgrow="ALWAYS" styleClass="glass-table">
        <columns>
            <TableColumn fx:id="colName" prefWidth="150.0" text="Nom" />
            <TableColumn fx:id="colCategory" prefWidth="120.0" text="Catégorie" />
            <TableColumn fx:id="colAddress" prefWidth="200.0" text="Adresse" />
            <TableColumn fx:id="colPhone" prefWidth="120.0" text="Téléphone" />
            <TableColumn fx:id="colCapacity" prefWidth="80.0" text="Capacité" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Statut" />
            <TableColumn fx:id="colActions" prefWidth="280.0" text="Actions" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>