<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefHeight="750.0" prefWidth="1100.0" styleClass="root-pane" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.GoVacateControllor">

    <Pane styleClass="deep-water-bg">
        <Circle fill="#FF8210" layoutX="150.0" layoutY="150.0" opacity="0.15" radius="180.0">
            <effect><GaussianBlur radius="80.0"/></effect>
        </Circle>
        <Circle fill="#679AC1" layoutX="900.0" layoutY="600.0" opacity="0.1" radius="250.0">
            <effect><GaussianBlur radius="100.0"/></effect>
        </Circle>
    </Pane>

    <BorderPane>
        <left>
            <AnchorPane prefWidth="260.0" styleClass="sidebar-liquid">
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="20.0">
                    <Circle fill="#FF8210" radius="8.0" stroke="WHITE" strokeWidth="2.0"/>
                    <Label styleClass="logo-text" text="GoVacate"/>
                </HBox>

                <Pane fx:id="slidingPane" layoutX="20.0" layoutY="140.0" mouseTransparent="true" prefHeight="45.0" prefWidth="220.0" styleClass="sliding-highlight"/>

                <VBox fx:id="menuContainer" layoutY="140.0" spacing="0.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <children>
                        <Button fx:id="btnExplorer" onAction="#showExplorer" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Explorer"/>
                        <Button fx:id="btnVoyages" onAction="#showReservations" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Les Reservations"/>
                        <Button fx:id="btnFavoris" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Favoris"/>
                        <Button fx:id="btnMessages" onAction="#showSupport" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Messages"/>
                        <Pane prefHeight="50.0" mouseTransparent="true"/>
                        <Button fx:id="btnParametres" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Paramètres"/>
                        <Button fx:id="btnLogout" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Déconnexion"/>
                    </children>
                </VBox>
            </AnchorPane>
        </left>

        <center>
            <StackPane>
                <children>
                    <ScrollPane fx:id="explorerView" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane">
                        <content>
                            <VBox spacing="40.0">
                                <padding><Insets bottom="50.0" left="50.0" right="50.0" top="40.0"/></padding>
                                <Label styleClass="text-header" text="Bonjour, Voyageur"/>
                                <VBox alignment="CENTER" spacing="25.0" styleClass="glass-panel">
                                    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
                                    <Label styleClass="hero-title" text="Votre prochaine destination ?"/>
                                    <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" styleClass="search-bar-liquid">
                                        <TextField promptText="Maldives..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                                        <Button styleClass="btn-orange-glow" text="Plonger"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <VBox fx:id="reservationView" spacing="25.0" visible="false">
                        <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/></padding>
                        <TableView fx:id="tableMesReservations" styleClass="admin-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUserId" prefWidth="120" text="Username" />
                                <TableColumn fx:id="colType" prefWidth="180" text="EXPÉRIENCE" />
                                <TableColumn fx:id="colDate" prefWidth="150" text="DATE" />
                                <TableColumn fx:id="colPrix" prefWidth="100" text="PRIX (DT)" />
                                <TableColumn fx:id="colStatut" prefWidth="140" text="STATUT" />
                                <TableColumn fx:id="colAction" prefWidth="150" text="ACTIONS" />
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox fx:id="supportView" spacing="25.0" visible="false">
                        <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/></padding>
                        <VBox spacing="5">
                            <Label styleClass="text-header" text="Support Client Direct" />
                            <Label style="-fx-text-fill: #679AC1; -fx-font-size: 13px;" text="Discutez en temps réel avec les voyageurs" />
                        </VBox>

                        <ScrollPane fx:id="adminChatScrollPane" fitToWidth="true" prefHeight="400.0" VBox.vgrow="ALWAYS"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                            <content>
                                <VBox fx:id="adminChatMessageContainer" spacing="15.0" style="-fx-padding: 20; -fx-background-color: transparent;" />
                            </content>
                        </ScrollPane>

                        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" styleClass="admin-search-box">
                            <padding><Insets left="20" right="20" /></padding>
                            <TextField fx:id="adminChatInput" onAction="#handleAdminReply" promptText="Répondre au client..."
                                       styleClass="admin-input" HBox.hgrow="ALWAYS" prefHeight="45.0"/>
                            <Button onAction="#handleAdminReply" prefHeight="45.0" prefWidth="100.0"
                                    styleClass="btn-orange-glow" text="Envoyer" />
                            <Button onAction="#handleClearHistory" prefHeight="45.0" prefWidth="110.0"
                                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;"
                                    text="🗑 Effacer" />
                        </HBox>
                    </VBox>
                </children>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>