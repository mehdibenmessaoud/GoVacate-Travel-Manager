<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefHeight="750.0" prefWidth="1100.0" styleClass="root-pane" stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.projet.GUI.GoVacateControllor">

    <!-- 1. FOND "EAU PROFONDE" -->
    <Pane style="-fx-background-color: #001F3F;">
        <Circle fill="#00d2ff" layoutX="200.0" layoutY="200.0" radius="250.0" opacity="0.2">
            <effect><GaussianBlur radius="60"/></effect>
        </Circle>
        <Circle fill="#FF8210" layoutX="900.0" layoutY="500.0" radius="300.0" opacity="0.15">
            <effect><GaussianBlur radius="80"/></effect>
        </Circle>
    </Pane>

    <BorderPane>

        <!-- 2. SIDEBAR GAUCHE -->
        <left>
            <AnchorPane prefWidth="260.0" styleClass="sidebar-liquid">

                <!-- LOGO -->
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="20.0">
                    <Circle fill="#FF8210" radius="8.0" stroke="WHITE" strokeWidth="2.0"/>
                    <Label styleClass="logo-text" text="GoVacate"/>
                </HBox>

                <!-- BULLE MAGIQUE (Sliding Pane) -->
                <Pane fx:id="slidingPane" layoutX="20.0" layoutY="140.0"
                      mouseTransparent="true" pickOnBounds="false"
                      prefHeight="45.0" prefWidth="220.0" styleClass="sliding-highlight"/>

                <!-- CONTAINER BOUTONS -->
                <VBox fx:id="menuContainer" layoutY="140.0" spacing="0.0"
                      AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <children>
                        <Button fx:id="btnExplorer" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Explorer"/>
                        <Button fx:id="btnVoyages" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Mes Voyages"/>
                        <Button fx:id="btnFavoris" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Favoris"/>
                        <Button fx:id="btnPost"
                                text="Post"
                                styleClass="liquid-btn"/>
                        <Button fx:id="btnMessages" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Messages"/>
                        <Pane prefHeight="50.0" mouseTransparent="true"/>
                        <Button fx:id="btnParametres" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Paramètres"/>
                        <Button fx:id="btnLogout" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Déconnexion"/>
                    </children>
                </VBox>

            </AnchorPane>
        </left>
        <!-- 3. CONTENU CENTRAL -->
        <center>
            <StackPane fx:id="contentArea"/>
        </center>

    </BorderPane>
</StackPane>
