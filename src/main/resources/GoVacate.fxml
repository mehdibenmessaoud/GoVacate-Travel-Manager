<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefHeight="750.0" prefWidth="1100.0" styleClass="root-pane" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.gui.GoVacateControllor">

    <Pane styleClass="deep-water-bg">
        <Circle fill="#FF8210" layoutX="150.0" layoutY="150.0" opacity="0.15" radius="180.0"><effect><GaussianBlur radius="80.0"/></effect></Circle>
        <Circle fill="#679AC1" layoutX="900.0" layoutY="600.0" opacity="0.1" radius="250.0"><effect><GaussianBlur radius="100.0"/></effect></Circle>
    </Pane>

    <BorderPane>
        <left>
            <AnchorPane prefWidth="260.0" styleClass="sidebar-liquid">
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="20.0">
                    <Circle fill="#FF8210" radius="8.0" stroke="WHITE" strokeWidth="2.0"/>
                    <Label styleClass="logo-text" text="GoVacate"/>
                </HBox>
                <Pane fx:id="slidingPane" layoutX="20.0" layoutY="140.0" mouseTransparent="true" prefHeight="45.0" prefWidth="220.0" styleClass="sliding-highlight"/>
                <VBox fx:id="menuContainer" layoutY="140.0" spacing="0.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <children>
                        <Button fx:id="btnExplorer" onAction="#showExplorer" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Explorer"/>
                        <Button fx:id="btnVoyages" onAction="#showReservations" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Les Reservations"/>
                        <Button fx:id="btnFavoris" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Favoris"/>
                        <Button fx:id="btnMessages" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Messages"/>
                        <Pane prefHeight="50.0" mouseTransparent="true"/>
                        <Button fx:id="btnParametres" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Paramètres"/>
                        <Button fx:id="btnLogout" prefHeight="45.0" prefWidth="220.0" styleClass="liquid-btn" text="Déconnexion"/>
                    </children>
                </VBox>
            </AnchorPane>
        </left>

        <center>
            <StackPane>
                <children>
                    <ScrollPane fx:id="explorerView" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane">
                        <content>
                            <VBox spacing="40.0">
                                <padding><Insets top="40.0" right="50.0" bottom="50.0" left="50.0"/></padding>
                                <Label styleClass="text-header" text="Bonjour, Voyageur"/>
                                <VBox alignment="CENTER" spacing="25.0" styleClass="glass-panel">
                                    <padding><Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/></padding>
                                    <Label styleClass="hero-title" text="Votre prochaine destination ?"/>
                                    <HBox alignment="CENTER_LEFT" spacing="15.0" prefHeight="70.0" styleClass="search-bar-liquid">
                                        <TextField promptText="Maldives..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                                        <Button styleClass="btn-orange-glow" text="Plonger"/>
                                    </HBox>
                                </VBox>
                                <Label styleClass="section-title" text="Destinations Populaires"/>
                                <FlowPane hgap="30.0" vgap="30.0" />
                            </VBox>
                        </content>
                    </ScrollPane>

                    <VBox fx:id="reservationView" spacing="25.0" visible="false">
                        <padding><Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/></padding>

                        <VBox spacing="5">
                            <Label styleClass="text-header" text="Gestion des Réservations" />
                            <Label style="-fx-text-fill: #679AC1; -fx-font-size: 13px;" text="Suivi détaillé des réservations clients" />
                        </VBox>

                        <VBox spacing="15" styleClass="admin-search-box">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <Label text="Recherche et Actions" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" alignment="CENTER" maxWidth="Infinity"/>

                            <HBox alignment="CENTER" spacing="15.0" styleClass="admin-white-bar">
                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="RECHERCHER PAR TYPE" styleClass="admin-mini-label"/>
                                    <TextField fx:id="txtSearch" promptText="Restaurant, Excursion..." styleClass="admin-input"/>
                                </VBox>
                                <Separator orientation="VERTICAL" />
                                <VBox prefWidth="150" spacing="2">
                                    <Label text="STATUT" styleClass="admin-mini-label"/>
                                    <ComboBox fx:id="comboStatut" promptText="Tous" styleClass="admin-combo" prefWidth="150"/>
                                </VBox>
                                <Button styleClass="btn-orange-glow" text="Rechercher" prefHeight="40" prefWidth="120"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="10" VBox.vgrow="ALWAYS">
                            <Label text="Liste des éléments" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <TableView fx:id="tableMesReservations" VBox.vgrow="ALWAYS" styleClass="admin-table">
                                <columns>
                                    <TableColumn fx:id="colUserId" text="Username" prefWidth="70"/>
                                    <TableColumn fx:id="colType" text="EXPÉRIENCE" prefWidth="180"/>
                                    <TableColumn fx:id="colDate" text="DATE" prefWidth="150"/>
                                    <TableColumn fx:id="colPrix" text="PRIX (DT)" prefWidth="100"/>
                                    <TableColumn fx:id="colStatut" text="STATUT" prefWidth="140"/>
                                    <TableColumn fx:id="colAction" text="ACTIONS" prefWidth="250"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </VBox>
                </children>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>