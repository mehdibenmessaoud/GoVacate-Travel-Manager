<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="reviewsSection" spacing="15.0" styleClass="glass-card"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <HBox alignment="CENTER_LEFT">
        <Label styleClass="hero-title" text="Avis clients"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addReviewBtn" styleClass="btn-orange-glow" text="+ Nouvel avis"/>
    </HBox>
    <TableView fx:id="reviewsTable" minHeight="150.0" prefHeight="200.0" styleClass="admin-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colReviewRating" minWidth="120.0" prefWidth="150.0" text="Note"/>
            <TableColumn fx:id="colReviewComment" minWidth="250.0" prefWidth="350.0" text="Commentaire"/>
            <TableColumn fx:id="colReviewUser" minWidth="140.0" prefWidth="180.0" text="Utilisateur"/>
            <TableColumn fx:id="colReviewActions" minWidth="180.0" prefWidth="220.0" text="Actions"/>
        </columns>
    </TableView>
</VBox>
