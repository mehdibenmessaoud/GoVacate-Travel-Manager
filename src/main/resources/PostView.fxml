<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootStack" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.GUI.PostControllor">

    <ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane">
        <content>
            <VBox spacing="40.0">
                <padding>
                    <Insets top="40.0" right="50.0" bottom="50.0" left="50.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <VBox>
                        <Label styleClass="text-header" text="Blogues"/>
                        <Label styleClass="text-sub" text="Découvrez les récits de la communauté"/>
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCompteur" text="0 Récits publiés" style="-fx-text-fill: white; -fx-opacity: 0.6;"/>
                </HBox>

                <VBox spacing="20.0" styleClass="glass-panel">
                    <padding><Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/></padding>
                    <Label styleClass="hero-title" text="Partagez votre expérience"/>
                    <VBox spacing="15.0">
                        <HBox spacing="15.0">
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="search-label" text="Titre"/>
                                <TextField fx:id="inputTitre" promptText="Ex: Mon voyage..." styleClass="search-field"/>
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="search-label" text="Image"/>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <!-- Remplacer le style en ligne par une classe CSS -->
                                    <Button text="📁 Choisir une image"
                                            onAction="#importerImage"
                                            styleClass="file-chooser-btn" />
                                    <Label fx:id="lblImageName" text="Aucun fichier sélectionné" style="-fx-text-fill: #b0b0b0; -fx-font-style: italic;"/>
                                </HBox>
                            </VBox>
                        </HBox>
                        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                            <Label styleClass="search-label" text="Votre récit"/>
                            <TextArea styleClass="search-field" fx:id="postContent" promptText="Racontez-nous tout..." prefHeight="100.0" wrapText="true"/>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT">
                            <Button onAction="#publishPost" prefHeight="45.0" prefWidth="160.0" styleClass="btn-orange-glow" text="Publier le récit"/>
                        </HBox>
                    </VBox>
                </VBox>

                <Label styleClass="section-title" text="Fil d'actualité"/>
                <FlowPane fx:id="postsContainer" hgap="30.0" vgap="30.0" />
            </VBox>
        </content>
    </ScrollPane>

    <StackPane fx:id="detailContainer" visible="false" managed="false" style="-fx-background-color: rgba(18, 18, 18, 0.95);" />

</StackPane>