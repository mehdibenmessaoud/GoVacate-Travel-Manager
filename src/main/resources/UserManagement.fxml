<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="mainStack" prefHeight="700.0" prefWidth="1100.0" styleClass="deep-water-bg"
           stylesheets="@/css/admin.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.projet.gui.UserManagementController">

    <VBox fx:id="listView" spacing="25.0">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Gestion des Utilisateurs" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Label text="Visualisez et gÃ©rez les comptes de la plateforme" style="-fx-text-fill: #679AC1; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <TextField fx:id="searchField" prefHeight="40.0" prefWidth="250.0" promptText="Rechercher nom ou email..." styleClass="search-input" />
                    <ComboBox fx:id="roleFilterCombo" prefHeight="40.0" prefWidth="120.0" promptText="RÃ´le" styleClass="glass-combo" />
                    <ComboBox fx:id="statusFilterCombo" prefHeight="40.0" prefWidth="120.0" promptText="Statut" styleClass="glass-combo" />
                    <Button onAction="#handleAddNew" prefHeight="40.0" styleClass="btn-orange-glow" text="+ AJOUTER" />
                </HBox>
            </children>
        </HBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.05); -fx-padding: 10;">
            <children>
                <TableView fx:id="userTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNom" prefWidth="200.0" text="Nom &amp; PrÃ©nom" />
                        <TableColumn fx:id="colEmail" prefWidth="250.0" text="Email" />
                        <TableColumn fx:id="colRole" prefWidth="120.0" text="RÃ´le" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Statut" />
                        <TableColumn fx:id="colAction" prefWidth="150.0" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </VBox>

    <VBox fx:id="formView" alignment="CENTER" visible="false" spacing="30.0" style="-fx-background-color: rgba(26, 37, 47, 0.95);">
        <children>
            <VBox maxWidth="550.0" spacing="25.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 40; -fx-background-radius: 20; -fx-border-color: #FF8210; -fx-border-width: 1;">
                <children>
                    <Label fx:id="formTitle" text="Modifier l'utilisateur" style="-fx-text-fill: #FF8210; -fx-font-size: 24px; -fx-font-weight: bold;" />

                    <GridPane vgap="20.0" hgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        </columnConstraints>

                        <children>
                            <VBox spacing="5.0" GridPane.columnSpan="2">
                                <Label text="Nom complet" style="-fx-text-fill: #bdc3c7;" />
                                <TextField fx:id="nomField" prefHeight="45.0" styleClass="search-input" />
                            </VBox>

                            <VBox spacing="5.0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                <Label text="Adresse Email" style="-fx-text-fill: #bdc3c7;" />
                                <TextField fx:id="emailField" prefHeight="45.0" styleClass="search-input" />
                            </VBox>

                            <VBox spacing="5.0" GridPane.rowIndex="2">
                                <Label text="TÃ©lÃ©phone" style="-fx-text-fill: #bdc3c7;" />
                                <TextField fx:id="telField" prefHeight="45.0" styleClass="search-input" />
                            </VBox>

                            <VBox spacing="5.0" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <Label text="Mot de passe" style="-fx-text-fill: #bdc3c7;" />
                                <PasswordField fx:id="passwordField" prefHeight="45.0" styleClass="search-input" promptText="Laisser vide si inchangÃ©"/>
                            </VBox>

                            <VBox spacing="5.0" GridPane.rowIndex="3">
                                <Label text="RÃ´le" style="-fx-text-fill: #bdc3c7;" />
                                <ComboBox fx:id="roleCombo" maxWidth="Infinity" prefHeight="45.0" styleClass="glass-combo" />
                            </VBox>

                            <VBox spacing="5.0" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                <Label text="Statut du compte" style="-fx-text-fill: #bdc3c7;" />
                                <ComboBox fx:id="statusCombo" maxWidth="Infinity" prefHeight="45.0" styleClass="glass-combo" />
                            </VBox>
                        </children>
                    </GridPane>

                    <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                        <children>
                            <Button onAction="#showList" prefHeight="40.0" prefWidth="100.0" text="ANNULER" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 10; -fx-cursor: hand;" />
                            <Button onAction="#handleSaveUser" prefHeight="45.0" prefWidth="180.0" styleClass="btn-orange-glow" text="ENREGISTRER" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>
</StackPane>
