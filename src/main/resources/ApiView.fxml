<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="api-toolbar-redesign"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox spacing="2.0">
        <Label styleClass="api-section-label" text="RECHERCHE VIA API EXTERNE"/>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Button fx:id="amadeusApiButton" prefHeight="38.0" prefWidth="155.0" styleClass="btn-api-amadeus" text="&#x1F30D;  Amadeus"/>
            <Button fx:id="openStreetMapApiButton" prefHeight="38.0" prefWidth="175.0" styleClass="btn-api-osm" text="&#x1F5FA;  OpenStreetMap"/>
        </HBox>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox alignment="CENTER_RIGHT" spacing="8.0">
        <ProgressIndicator fx:id="apiLoadingIndicator" managed="false" maxHeight="20.0" maxWidth="20.0" minHeight="20.0" minWidth="20.0" progress="-1.0" visible="false"/>
        <Label fx:id="apiStatusLabel" styleClass="api-status-pill api-status-idle" text="Pret pour recherche API"/>
    </HBox>
</HBox>
